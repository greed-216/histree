  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003124",
      "reason": "袭封、谒陵各日明确。五府赈灾乙酉不见于闰二月历表，月日待考；缅甸进犯永昌亦无日。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003125",
      "reason": "同科进士名录待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003126",
      "reason": "广东罗定兵变确日及首领待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003127",
      "reason": "底本作“我大清”反映清修明史立场。图伦城确址、战事路线和尼堪外兰稳定人物键待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003134",
      "reason": "贡使抵达日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003136",
      "reason": "获释后裔的具体名单与人数待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003138",
      "reason": "张居正家属抄没经过及陇川另阶段待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003141",
      "reason": "各家属处分与赴戍的实施日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003142",
      "reason": "寿宫地点、告成日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003146",
      "reason": "各次贡使抵达日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003149",
      "reason": "南京震灾与京师旱情分录；京师干旱起日、解除日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003150",
      "reason": "把兔儿、炒花稳定人物键、徐贞明受命确日待核。"
    }
  ]
}
