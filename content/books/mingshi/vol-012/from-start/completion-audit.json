  "pending_paragraphs": [
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001714",
      "observations": [
        "壬午复位与丙戌颁改元诏分别见本纪，沿用已发布年表复位事件的ID，并独立校正其事序叙述。徐有贞首任阁职职衔有异，罚黜实际执行日与汤序稳定人物键待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001715",
      "observations": [
        "李贤入阁时本纪作吏部侍郎、年表作礼部侍郎，保留异文。柳溥稳定人物键、石璞实际返抵朝廷日期待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001716",
      "observations": [
        "复储与诸王受封同日分记，黎淳稳定人物键及延绥用兵经过待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001717",
      "observations": [
        "铜鼓、藕洞及种兴稳定定位待核。罢团营与卷十一置团营分录。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001718",
      "observations": [
        "柳溥稳定人物键与部署详细时地、杨瑄张鹏初下狱日待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001719",
      "observations": [
        "六月数次关押、贬外与复任按原文明日次序。李贤七月后续另有年表记录，蒋琳下狱经过及稳定人物键待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001720",
      "observations": [
        "徐有贞再次被关押和被逐有不同干支，年表同条亦记录两阶段。岳正后续下狱、谪戍的确日据另条考证。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001721",
      "observations": [
        "彗星观测时点和祷告时点分别，本纪只系祷告于甲午。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001722",
      "observations": [
        "年表九月彭时兼侍读入阁、十二月升学士，本纪九月作兼学士，保留异文。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001723",
      "observations": [
        "王振祠名在本纪作旌忠、在传作精忠。所释朱文圭家属的姓名本纪未记。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001724",
      "observations": [
        "田州战事从总兵奉命到后来平定各有不同阶段，参田州条。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001725",
      "observations": [
        "钦封昭武伯与其后来升侯、起兵分开记录。柳溥行军确日原文未载。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001726",
      "observations": [
        "各贡使到达日期待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001728",
      "observations": [
        "太后尊号全文及陈汝言入狱缘由由其他段另考。亲祭太庙与南郊分日。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001729",
      "observations": [
        "银场位置、宦官姓名与采买明细待考。两条分录。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001730",
      "observations": [
        "土木此前也曾有收葬记载，此举依本纪在天顺二年闰二月另立。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001732",
      "observations": [
        "获授、辞官、被送回乡是相继行动，归乡确日待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001733",
      "observations": [
        "石彪此时仍为定远伯，后进侯时点有异，参以后正文与卷末校记。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001737",
      "observations": [
        "年度回顾，各使到达月日未载。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001739",
      "observations": [
        "安边营地望、杨信周贤李鉴稳定人物键待核。正月战事和四月进侯分录，卷末校记保存两种时点。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001740",
      "observations": [
        "御史、宦官姓名与采珠范围待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001741",
      "observations": [
        "叶盛与方瑛两次战事分录，参与力量及各自地望待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001742",
      "observations": [
        "六月颁命，八月召集，各处实际抵达日期待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001743",
      "observations": [
        "石彪获罪细节另核，交结禁令按铁榜称呼保存。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001744",
      "observations": [
        "石亨罢任与后来下狱、死亡另录。霜降审录的实际制度细节待列志录入。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001746",
      "observations": [
        "本纪用疏球，依全书地方称谓以琉球检索。各贡使日期待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001748",
      "observations": [
        "癸卯为下狱日，石亨去世确日未载。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001749",
      "observations": [
        "保留底本族称，攻陷梧州者所属支系和首领待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001750",
      "observations": [
        "王一夔稳定人物键、进士其余人名待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001751",
      "observations": [
        "督课使者姓名与具体银场待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001754",
      "observations": [
        "降雨起止、洪峰、各州县受灾范围和日食观测地点待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001755",
      "observations": [
        "本纪以李文、杨能为防御诸将，卷156李文条称李文按兵未战；保存两处说法及前后次序。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001756",
      "observations": [
        "白玉、鲍政的稳定人物键及各处布置待考。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001759",
      "observations": [
        "郑村坝地望和检阅详细对象待核，所录为闰十一月。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001760",
      "observations": [
        "各次来使确切日期待核，疏球沿原文。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001763",
      "observations": [
        "各路军队启程和实际战事日期另核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001764",
      "observations": [
        "各地起事者的身份、活动范围保留原书用语，具体地望待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001765",
      "observations": [
        "白圭奉命确日已录，具体交战经过另查列传。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001767",
      "observations": [
        "河西战败与增派京营兵先后有确日，驻军姓名和地点待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001768",
      "observations": [
        "起兵、寇深之死、曹吉祥与同党受刑分别记录。吴瑾、汤序、薛远稳定人物键及河西作战详细地望待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001769",
      "observations": [
        "有声系本纪记载，地震规模和影响范围待考。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001770",
      "observations": [
        "冠带品级和各地实施办法待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001771",
      "observations": [
        "日食观测地点原段未记。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001772",
      "observations": [
        "各贡使实际到达日期待核；疏球依原文保留。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001774",
      "observations": [
        "孛来使者及贡品未载。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001775",
      "observations": [
        "谕令原文及实际送达日期待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001776",
      "observations": [
        "随同冯宗召还的成员、启程与返抵确日待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001778",
      "observations": [
        "本纪记平定，具体各支起事、交战和结果以列传继续校核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001780",
      "observations": [
        "海溢确日、受灾范围与损失待考。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001781",
      "observations": [
        "以紧接十一月安葬的谥号及卷113后妃传核太后身份。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001783",
      "observations": [
        "各贡使到达确日待考。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001787",
      "observations": [
        "各处停办银场的范围和持续时间待核。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001788",
      "observations": [
        "李蕃稳定人物键、死日及案件缘由待核。有本纪确日者为拘捕及枷示。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001789",
      "observations": [
        "杨琎仍须与同名者区分，事件缘由及日食可见地另考。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001790",
      "observations": [
        "韩祺死亡确日及案件缘由待核。有干支者为拘捕枷示。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001792",
      "observations": [
        "《后妃传》以闰七月同记胡善祥上尊谥。洪江地望及各军分工待核。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001793",
      "observations": [
        "欧信稳定人物键与两广合兵日期待核。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001794",
      "observations": [
        "吴桢为天顺朝广西巡抚。与明初武将吴祯区分，身份详情进一步核对。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001795",
      "observations": [
        "宋钦异名见卷末校记。李宾、林聪下狱案情待核。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001796",
      "observations": [
        "本纪以辛卯记下狱，随后获释确日未载。年表与本纪同日范围归公元1464年。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001797",
      "observations": [
        "各贡使日期待核。"
      ]
    },
    {
      "batch": "part-09",
      "paragraph_id": "mingshi-2f603db3d81e-p001799",
      "observations": [
        "病、摄事、遗诏和去世分录。年三十八是本纪原说。"
      ]
    },
    {
      "batch": "part-09",
      "paragraph_id": "mingshi-2f603db3d81e-p001800",
      "observations": [
        "原纪二月乙未用于上尊谥，校记订正旧三月。葬日按卷十三五月庚申，两条各自保留原文。"
      ]
    }
  ],
