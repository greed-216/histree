  "coverage": "连续第1—8段，原49—56行；正月至二月及追述；后接第9段三月己卯朔任官。",
  "source_issues_review": "冯延己、延已、延巳按职务同人校核；从曾孙支系、原文在巳上等字形及纸本待核。计划与执行、旧事与当年分别标明。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v283-y0943-p001",
      "note": "宦官兼领永平及非议，王承休仅为历史先例。"
    },
    {
      "paragraph_id": "zztj-v283-y0943-p002",
      "note": "己未出发、乙丑到达分别录；旧新纪补赦囚与旧纪封丘停留。每月问遗为概述不造逐月使者。"
    },
    {
      "paragraph_id": "zztj-v283-y0943-p003",
      "note": "追述继承人打算、训斥、种氏建议与命嫁、献丹和身体变化、王栖霞言行，具体年月为空。评价、梦境、医学描述归于史料。亲子方向明确，命嫁未造配偶。"
    },
    {
      "paragraph_id": "zztj-v283-y0943-p004",
      "note": "冯己已据新史巳校核同人，不改底本。官员批评保留发言者，病情不作现代诊断。二月庚午召侍、遗劝和夜死与秘丧监国赦分开，后续丙子是遗制公布日。"
    },
    {
      "paragraph_id": "zztj-v283-y0943-p005",
      "note": "孙晟欲称遗诏让太后临朝为未执行打算，李贻业反对后停止。从曾孙支系未核，不造直系链。"
    },
    {
      "paragraph_id": "zztj-v283-y0943-p006",
      "note": "丙子遗制公布与陈觉称病数月、出现、萧俨弹劾及拒绝分开；等待去世是弹劾中的指责。"
    },
    {
      "paragraph_id": "zztj-v283-y0943-p007",
      "note": "吴相时期政策、赎人及旧卖子女请求为追述，日期为空；草遗诏、萧俨反对、查旧奏及未改规定为943年当下。禁压良不等于禁全部奴婢交易，动机与评价归于史书或发言者。"
    },
    {
      "paragraph_id": "zztj-v283-y0943-p008",
      "note": "建殷称帝改元大赦、两州建制、立后、四任官、礼仪沿用和税政分别录；未几不补确切日。新史独立补证称殷改元，未推全闽统一或具体税率。"
    }
  ],
  "plain_language_review": "首次检查人物介绍、事件标题正文、参与动作、关系方向和对应事实说明。展示用简体白话，原文逐字保留；计划、对话评价与执行分开，未知追述年月为空。"
}
