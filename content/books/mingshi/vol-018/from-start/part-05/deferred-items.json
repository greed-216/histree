  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002807",
      "reason": "六科受杖者未列姓名；另存五阅月后突围，具体日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002809",
      "reason": "按本卷校记核过三月月界，余众进入青、徐界的确日和途经待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002810",
      "reason": "都司周应桢及其他战死人员的规范键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002815",
      "reason": "各使团抵达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002818",
      "reason": "本月蓟镇战事未载日，赵倾葵以外的参战及阵亡将士待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002821",
      "reason": "王江泾一役其他参将与军队调动细节待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002825",
      "reason": "秋粮减免确日待考，保留秋季精度。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002826",
      "reason": "三人各自审理阶段后续可对照本传。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002829",
      "reason": "各州县震损、死亡构成及矿区细址待考。死亡数为本纪原载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002830",
      "reason": "贡使到达日期待考。"
    }
  ]
}
