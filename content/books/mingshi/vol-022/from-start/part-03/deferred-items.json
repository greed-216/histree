    {
      "paragraph_id": "mingshi-2f603db3d81e-p003563",
      "reason": "万燝、林汝翥遇责及各地奏疏各自确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003565",
      "reason": "三人削籍确日未载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003566",
      "reason": "普定与织金两战各自日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003567",
      "reason": "两当民变的确日和经过待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003569",
      "reason": "庆陵工程实际完工日期、荫赏全名单及织金军溃各自确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003570",
      "reason": "六人的拘押、遇难确日待核。余煌同榜名单待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003574",
      "reason": "保留本纪所写三次京察的干支，癸亥在天启三年，三次京察范围与称年异处待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003575",
      "reason": "各书院实际毁废日期及名单和孙慎行等人削籍确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003577",
      "reason": "吴怀贤受杖去世实际确日、皇子身份和生日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003579",
      "reason": "榜示的具体版本和完整名单待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003580",
      "reason": "贡使抵达确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003582",
      "reason": "解围与编书分录；战事各方个别日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003583",
      "reason": "高攀龙去世和其余六人下狱后的分日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003584",
      "reason": "边镇内臣全名单、刘应坤到任和魏良卿获封确日待考。“从子”保留原称。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003585",
      "reason": "丁绍轼卒日明确，当月升衔之日另外待核。"
    }
  ]
