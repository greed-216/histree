  "coverage": "原87—94行连续八段，后续未计。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v293-y0957-p023",
      "note": "命张湜等编释与成书颁布分开，旧十人审核程序为计划，宋范质建议者参与同事件，不顶替张职。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p024",
      "note": "郭迁谓同段后称廷谓，沿已有郭廷谓，原异字保留。断桥、定远袭败、李璟任滁州分阶段，旧死亡数百为回述不定七月战日。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p025",
      "note": "李廷珪请解与六月乙丑加荣衔免军职分开。李氏沿孟昶母同人，回忆旧朝择将与对当前五将评价均为她的判断，被评论者不当在场。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p026",
      "note": "丁丑王祚颍州任、父亲关系，宋父祚传上下文身份核。治理任内year null，主朝服侍父和宋宿州宋初礼节不全定957；犭屯犬与豚犬异字保原，不造长幼动物事件。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p027",
      "note": "七月丁亥两改职对应定远及956南寨追责，不把过去战日当改职日；后周李继勋与后蜀同名分开。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p028",
      "note": "初立七庙非本日即位，新显圣宫补地点，赦改元立庙合叙不移到正月朔。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p029",
      "note": "乙亥准罢相，仍司空与每月入议政不等完全退休；二年与旧周岁病期差异保留。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p030",
      "note": "八月王朴升枢密使检校太保，旧接乙亥条与主无独日分别说明，不重复956副使任命。"
    }
  ],
  "source_issues_review": "郭迁谓同段廷谓识别既有主体；犭屯犬与宋豚犬异字保留。王祚宋初宿州礼节不固定957，李谷二年与周岁病期异说并列；匿名详定官员与被评论将领不补在场名单。纸本与异文待核。",
  "plain_language_review": "首次逐条核对人物、事件标题正文、角色关系及事实说明。建议、诏令与完工，太后评价与确定能力，追责日与战日，罢相与完全退休均区分。被评价人无在场边，关系父亲方向明确；引用原字不改。"
}
