        "raw_excerpt_sha256": "e89174a8b8016898609e399da674a15cd3a1515edb1f6cec2e50de866cb0f186",
        "epub_member": "OPS/c10_ming_shi_juan10.xhtml",
        "member_sha256": "e2d801e9112e184937853f41e5f815a60a644bbba48f42c57c174c185f9552d8",
        "element_paths": [
