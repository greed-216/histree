{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002076",
      "reason": "收回赐田的田亩、地望和后续分配待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002079",
      "reason": "五万人依本纪原数。渠段和治理工期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002083",
      "reason": "于谦赐谥和立祠为本次新事。具体谥号与后来改谥依列传再校。十二月干支依历表核年。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002084",
      "reason": "各次使者抵达或启程日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002088",
      "reason": "预备仓各里实际定额、钱福和同榜名单、张海与元守直的规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002090",
      "reason": "按历表核原文闰月为闰九月。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002092",
      "reason": "各干支按历表换算；上元节灯火依原文是次年拟办活动。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002093",
      "reason": "各次贡使到达日期待核。"
    }
  ]
}
