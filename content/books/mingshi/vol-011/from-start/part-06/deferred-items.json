  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001663",
      "reason": "黄河水清持续时间、抚辑各自负责地区和银场停办范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001665",
      "reason": "孙贤规范人物键及王文出行确日待核。《麓川平缅传》记此前获俘和交接后送京，本纪庚辰保留为执献条。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001666",
      "reason": "日食观测地域、方瑛封爵确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001667",
      "reason": "《章纶传》记两人先后上奏，本纪同列五月甲子下狱。各次上奏日期和后续处置另录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001669",
      "reason": "水灾实际范围待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001671",
      "reason": "原文所列七处共二百余万石，各地数额待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001672",
      "reason": "征讨对象、具体战事时地待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001673",
      "reason": "织造采办结束的执行细节待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001675",
      "reason": "年度回顾未载各贡使入明、也先被杀的具体日期，保留原历年界的公元区间。"
    }
  ]
}
