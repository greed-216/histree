  "pending_paragraphs": [
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000347",
      "observations": [
        "刘福通、徐寿辉、徐州诸将及方国珍为总结其他年份的乱局，不能放入至正四年。已见《续资治通鉴》相关事件，候选的范围异同还需逐一对照。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000349",
      "observations": [
        "卜问及形貌是入军故事的叙述，不另立可证行动。徹里不花与元末将领的异译对应待核。朱元璋在郭孙间调解，原文无逐次日期。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000350",
      "observations": [
        "彭大及赵均用与旧事件参与者同一。李二逃亡后死亡须核两书所指时点及死亡证据，先保留本纪原文。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000353",
      "observations": [
        "横涧山对手在两书作张知院、缪大亨，先保留异称，不直接定为同人。攻克滁州是否为现有攻滁条目及其年份待核后另补。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000356",
      "observations": [
        "脱脱后被解除兵权只能沿上下文找既有事件，不能直接套本段十月。朱元璋遣父老交涉时所称守城缘由属于当事人的说法。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000358",
      "observations": [
        "元军围和州并企图断粮一段须核已有战事及秃坚、绊住马的异译；改城墙和释放妇女用整段叙事支持。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000359",
      "observations": [
        "本纪把迎立韩林儿写在郭子兴卒的背景中，不能沿用前句的三月。朱、张任左右名单与另一书写法有别，各依原记。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000363",
      "observations": [
        "两书都记郭、张攻集庆遇叛后死亡，但直接死亡过程不同；兆先与陈埜先的亲属说法也不同。陈埜先死亡及兆先收兵待比对已有记录。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000367",
      "observations": [
        "背景列举诸军各自据守的州郡，先按背景保留，不套同一个三月。攻克镇江确月须核同事来源。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000377",
      "observations": [
        "徐达取常熟与本月擒张士德相关，但旧条题作擒张士德、攻诸寨。待核是否当次直接克城再决定是否复用，未另立节点。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000380",
      "observations": [
        "本纪明示明玉珍为徐寿辉部将，待核已有端点关系。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000384",
      "observations": [
        "徐寿辉与陈友谅的上下级关系由将字明示。先核线上端点，避免重复建立关系。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000385",
      "observations": [
        "后半回顾刘福通部将先前各路行动，未载各事年月。此次只记录破汴梁迁都，前事各自另候校核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000386",
      "observations": [
        "本纪作宁城府，《续资治通鉴》及下文作宁越。校勘注还指出范祖干、叶仪与许元等人的两件任用被合记，暂不按同一次任用发布。五色云保留为本纪叙事。招谕方国珍待查已有事件。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000388",
      "observations": [
        "立郡学在本纪载于至正十九年正月，另一书记于十八年十二月；两书原历日期各自保留。治军引语是要求和当事人自述。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000389",
      "observations": [
        "方国珍与关的父子关系由原文明示，核查既有连接后补充证据。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000390",
      "observations": [
        "池州收复确有本月。长兴、江阴、常州各地屡次战事为总述，未把多次交战统一定在四月。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000398",
      "observations": [
        "保留清楚的宋濂授经及指挥、战斗等明确行动。朱标与宋濂师生、父子关系待对照已有标签和原文。收复太平及攻下安庆的两事须与旧记录逐一核对日期和范围。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000400",
      "observations": [
        "欧普祥曾为徐寿辉旧将，具体既有关系及有效时间待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000403",
      "observations": [
        "宝源局的己亥日取底本校勘后的字形，保留乙亥异文。盐茶课与现有议盐法记录的关系待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000404",
      "observations": [
        "改设大都督府,先与其他已有制度记录对照后再建项。方国珍使者为未具名人物。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000406",
      "observations": [
        "安庆、江州同次行动沿用已核事件。后文所列南康、建昌等地相继攻下，分别核对各地的旧记录后补。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000409",
      "observations": [
        "见孔庙属于朱元璋赴龙兴后的行动；龙兴周边归附尚须逐条与旧记录核对。胡廷瑞后改名胡美，卷末校勘注保留官名异说。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000410",
      "observations": [
        "李祐之姓名和已有异体名要核定。两地叛变分别保存，蒋英死亡记录无涉本段。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000414",
      "observations": [
        "当月察罕来信并扣留使者与后来被杀是两个行动。先核旧来信记录是否对应，未把扣留与死亡写成因果。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000416",
      "observations": [
        "旧条涵盖张昶被留用等后事；本纪只支持受命、到庆元和朱元璋拒绝受官。扩廓归还使者须与汪河往返信件分别核对。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000419",
      "observations": [
        "刘福通之死的年次和史源说法存在分歧，须回查本书相关传记与已有日期后单列。饶州一事本纪署张定边，关于入城内应他书另有细节。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000422",
      "observations": [
        "礼贤馆的兴建及陈军攻临江暂在段落中保留，旧事件名称及赵天麟官职仍待核。刘齐的参政职称见卷末校勘注。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000423",
      "observations": [
        "鄱阳湖各日行动分开整理，六十万保留史书号称的说法；复战等未直接绑定为其他书独立日期相同。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000424",
      "observations": [
        "本纪载陈友谅之子理，父子连接须和已有关系核同。事件保留张定边带陈理走武昌，不附加本纪未言的具体后继日期。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000429",
      "observations": [
        "本纪还有立子标为世子，须查旧吴王即位条和朱标现有身份记录，父子边也待核复用。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000431",
      "observations": [
        "起居注已匹配。十七卫与其他军制设置有不同时间和名称，回查旧官制条；返应天另核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000432",
      "observations": [
        "南昌祭赵德胜与《续资治通鉴》相合，康郎山祭丁普郎是否有单独旧条待核，留本纪并列文字。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p000433",
      "observations": [
        "庐州攻克用确定的七月纪年。常遇春另一路略江西要与下月吉安所记行动区分。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000437",
      "observations": [
        "襄汉与湖湘诸郡行动分别看原文，不由攻取宝庆整体推定同日受降。熊天瑞身份与既有投降边须核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000438",
      "observations": [
        "李伯昇与既有李伯升极可能同人，须核具体官职和事迹后补主体连接。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000448",
      "observations": [
        "明升为明玉珍的儿子，既有身份及关系须核对后追加出处，暂保正文。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000450",
      "observations": [
        "本纪把攻淮安、淮东归附、省墓、宴父老和攻安丰连载，后四州归附与攻安丰须在各自旧记录下复核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000451",
      "observations": [
        "庚寅求遗书的对象和既有条目有待核查，先保留明示返应天。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000452",
      "observations": [
        "旧书把围湖州、张士诚亲援和皂林交战分作数事，须逐句划分引用。本批录已可确认的建宫、出兵与进军决策。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000455",
      "observations": [
        "张天骐与张天麟、潘原明与潘元明为待核异称。围平江另核具体起始条目。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000457",
      "observations": [
        "扩廓帖木儿与李思齐、张良弼积怨且数次交战。是年为总述，未把未指出的各次交战写成单年事件；关系和逐次战事需回查独立证据。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000460",
      "observations": [
        "此李二为扩廓部将，和卷首徐州起事的李二须分核。先保留擒获姓名，未把人并到卷首。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000464",
      "observations": [
        "给赴任地方官路费、赏赐家属及因雷击赦囚须回核其他已录制度和大赦记录，先保存贡粮条。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000466",
      "observations": [
        "定连坐范围、送元宗室北归、平吴封爵与新宫落成待按各自旧事件核对，已清楚的克平江、征方国珍与建太庙先记。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000467",
      "observations": [
        "北伐议策与甲子出师分开；出师将领和人数待核对应条目。祭元臣与定礼乐分别回查。后文胡廷瑞名称说明见卷末校勘。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p000469",
      "observations": [
        "原历十二月各项时间单独保留，公元年按历表核对。张兴祖进东平等支线行动仍待复见核对。"
      ]
    }
