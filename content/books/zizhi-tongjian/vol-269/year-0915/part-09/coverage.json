  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v269-y0915-p029",
      "note": "“乙丑，改元”底本短句与另本一致；新五代史本纪亦无年号字样，年题贞明元年，不能把该句误称缺文。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p030",
      "note": "“宗绛入秦州”人名疑字未定，不创设王宗绛或擅改为王宗绾；王宗鐸按既有王宗铎繁简同人。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p031",
      "note": "主书明“彦韬即温韬”，旧批次重复人物的一条参与和一条声明已迁至温韬，重复人物已隐藏；见content/revisions/2026-10-02-wen-tao-li-yantao/publication.json。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p032",
      "note": "通正为下一年所用，915年只有宣布改元，不提前改纪年。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p033",
      "note": "刘岩封号通鉴／旧五代史作南平王，新五代史作南海王；后名刘龑与既有刘岩同人，封号与改名年份待纸本核。"
    }
  ]
}
