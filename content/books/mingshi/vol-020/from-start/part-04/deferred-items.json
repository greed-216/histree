    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003099",
      "reason": "广西八寨各次战事和当地组织待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003102",
      "reason": "贡使抵达日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003104",
      "reason": "周之望稳定人物键、当年裁官明细及袄郎兔具体地点待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003105",
      "reason": "本纪三月、实录四月乙巳互异；保留两处纪年，各部出兵细节待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003106",
      "reason": "户部书成、进呈当日及赈灾细目待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003110",
      "reason": "各贡使抵达及各项裁减施行日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003113",
      "reason": "张佳胤受命与兵变平息确日待分别核查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003114",
      "reason": "马景、许汝继、晋应槐规范人物键，及处死马景的独立日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003115",
      "reason": "后裔各家与减免数额待考；只登记针对后人的诏令。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003116",
      "reason": "潘晟任命与罢免相次；不以乙巳代作撤任日期。张居正去世的丙午也不同于晋太师。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003118",
      "reason": "本段丙辰为赦令，皇长子生日由光宗本纪另载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003120",
      "reason": "复职官员具体名单待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003121",
      "reason": "贡使到达日期及减免地区明细待考。"
    }
