  "coverage": "原101—111行最后十一段；年度全覆盖与年界核验后才记全年完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v293-y0957-p037",
      "note": "境风疑字原保，安集内部为即位后概述留null；崔勋与951北汉李存瑰会军、到潞城下还并非攻克。契丹派军未明君主亲令，不造角色，厚赠金额未知。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p038",
      "note": "乙卯泗降授范宿职与护田军纪概述分开。戊午三路追、主庚申追及与旧己未不同，辛酉胜与陈承昭捕、三百船七千人残余俘获分口径。宋本纪承诏与本传承昭同战同职校名，旧本传春季误合不移本战。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p039",
      "note": "使还消息与逼写、李延邹拒而被杀、濠降获兵粮、唐赏匿名子分阶段。旧壬戌补降日，不强定杀人同日；父亲方向明确，子姓名官名不造。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p040",
      "note": "壬戌渡淮设楚州西北营，不等克城。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p041",
      "note": "乙丑涟水崔降，旧同日职称地点核。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p042",
      "note": "丙寅郭亳职，旧陈迁沂职与陈承昭右监门职为补；释放由宋传补明未强同日。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p043",
      "note": "戊辰仅克楚州月城，主城待958。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p044",
      "note": "庚午入见肯定此前报效唐并派攻天长，郭原断桥不是为周；武抵高邮、扬被焚驱民、数日后所见十余病弱与癸酉奏、丁丑泰取分段。湖南和袭泰军未具名不补将，旧注文僑异常字保原不算对话丙寅明确日。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p045",
      "note": "卢膺卒为957末记，具体日地点原因未载，新死亡年据年条。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p046",
      "note": "刘弘熙沿已核刘晟同人，忧惧遣贡阻湖南、修备、后来纵酒分开；既而饮酒概述null，不把湖南执行人强写周行逢。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p047",
      "note": "使者南游太原礼遇数日北返与竟卒结局分开，实际游行、死亡日年未独立纪时留null，不强定957。"
    }
  ],
  "source_issues_review": "境风与旧僑疑字原保不擅校。追及庚申与己未、陈承昭承诏姓名异文各保，三百船七千人不是全部死亡沉船。陈处尧竟卒和南游没有独立年月，留未知。卢膺及李延邹当年卒明记，匿名子不造实名。纸本及地理待核。",
  "plain_language_review": "首次逐条检查事件正文标题、人物参与、父亲关系及事实解释。情报与行动、正式降城与先前许禀、军事授职与放俘、外围设施与主城分开；评价转述不作全体心理事实，数字口径与追叙时间写清，引用原字不改。"
}
