  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002401",
      "reason": "本科其他登第人名录待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002402",
      "reason": "郑廉的稳定人物键待核，与《续资治通鉴》的同名人分辨。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002405",
      "reason": "同月出关及劝返各依原文日次逐项处理。张钦传另叙折返地点，待该传独立录入时补充。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002407",
      "reason": "小王子稳定人物键待核。战事与撤退分列，沿用本纪所记战五日。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002411",
      "reason": "琉球、乌斯藏各次贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002413",
      "reason": "狩猎之后辛亥回宫；当月赈灾和给米的执行详情待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002417",
      "reason": "驻喜峰口在同段，未单列启程日，保留其五月至戊申返回的先后。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002418",
      "reason": "乙酉由昌平返回列于丧葬段，个人起讫路线待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002421",
      "reason": "卷307江彬及许泰传与本纪正德八年赐国姓条互证；朱寿为武宗本人所用姓名。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002423",
      "reason": "戴钦稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002425",
      "reason": "各次使者到达日期待核。"
    }
  ]
}
