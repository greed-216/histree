  "coverage": "卷291原81—90行连续十段；954年跨卷291、292共63段，尚未完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v291-y0954-p001",
      "note": "仍为郭威，病中省礼、大赦显德改元与蜀境通商分别录，不将显德改元归柴荣。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p002",
      "note": "邺都地位撤销与军镇存续区别，旧纪同日大名府序位补证。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p003",
      "note": "兼侍中、判兵马及人心反应为庚辰，旧新合叙不同，不把即以王判强改丙子。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p004",
      "note": "军士赏额流言、郭威壬午责诸将及诸将捕杀挑事者分开，不把流言当真实财务统计。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p005",
      "note": "曹翰受郭知遇、澶州牙将、953至954劝入侍与丙戌大事由柴荣执行分开；宋传大名及府事托付补证，初不强定本年。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p006",
      "note": "郑仁诲任枢密使，旧纪明确丙戌，主书承前未列日，保存补证。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p007",
      "note": "三留后正授分录，旧纪同批含田景咸未当主书原句；韩通太原为籍贯。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p008",
      "note": "薄葬遗命拆棺衣速葬、雇工与守陵户、禁奢墓制及两项人事指示；遗命不提前当执行，唐陵盗掘为郭威自述。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p009",
      "note": "此前八口决河与庚寅分遣修塞分开，不伪写工程当日已完成。"
    },
    {
      "paragraph_id": "zztj-v291-y0954-p010",
      "note": "王溥复用后周宋初主体；壬辰末次任职、李拜柴、郭死、乙未遗制及丙申即位分开，旧本纪合叙与世宗纪细日分别保留；俸兵领镇不编赴镇。"
    }
  ],
  "source_issues_review": "君主在丙申柴荣即位处切换，此前帝均郭威；即位和遗制纪日不同本纪保留。史书注文非独立文本，军名州名不同称谓不乱造人物。紙本异文待核。",
  "plain_language_review": "首次逐条核对标题、人物、角色、时间地点及事实解释，主语明确；病中礼仪、遗命与执行、临终任命、死亡与发丧、旧事与当前年分别说明。原文保底本。"
}
