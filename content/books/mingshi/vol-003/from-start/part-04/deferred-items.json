  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000745",
      "reason": "甯正和思伦发的规范人物键，马龙他郎甸的地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000746",
      "reason": "任亨泰等人身份、思伦发交战各自地点待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000747",
      "reason": "地保奴等的稳定身份和捕鱼儿海地望、有无其他估算人数待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000749",
      "reason": "陈桓身份及东川用兵见后文战事条，任将与战果分别录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000750",
      "reason": "琉球地理所指和地保奴身份另核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000751",
      "reason": "“河南、北田”地望和断句，孙恪人物键待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000752",
      "reason": "秦、晋等八位藩王规范人物键及越州阿资身份待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000755",
      "reason": "各贡使日期与安南君主炜、黎季犛身份另查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000757",
      "reason": "宗人令及各宗正、宗人另待逐人核对其身份与在任年月。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000758",
      "reason": "夏得忠、叶昇、阿资的规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000760",
      "reason": "徐允恭、常昇身份及“眈罗”字样与前文“耽罗”的地名对应待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000765",
      "reason": "金镇及思伦发的规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000766",
      "reason": "周王朱橚获罪原委和罢徙日另查；迁徙命令与取消是相继两步。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000767",
      "reason": "北元脱古思帖木儿遇弑、继位者姓名及其年份须校相关条目；高丽两次废立的日期独立校验，安南条保留校记[3]。"
    }
  ]
}
