{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001624",
      "reason": "星变的具体天象及授田、贷种推行范围待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001625",
      "reason": "其余进士姓名、授予名次待另查，柯潜名次待列传卷录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001626",
      "reason": "平越战事及送俘到京的各自日期待核。后两条与平越战事另按干支记录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001628",
      "reason": "本纪明载预计发生日食而未见，可见地点及天象原因待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001629",
      "reason": "各地起事经过与进军日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001633",
      "reason": "脱脱不花被杀的具体日未载，保留本纪十二月与《鞑靼传》年条。两条入阁沿年表审定的公元1452年。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001634",
      "reason": "各贡使实际到达日期待核。"
    }
  ]
}
