{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003495",
      "reason": "皇长子的生日仅有原历月份，郑贵妃所生福王的具体出生日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003496",
      "reason": "皦生光与两位内侍各自被处置的明确日期和稳定身份待核，王曰乾依校记。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003498",
      "reason": "各处实际停矿税及复职官员名单待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003499",
      "reason": "史继偕等受命、到任各存确段。十三名受召者全名单与进红丸后的史料异说待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003500",
      "reason": "分别核对光宗崩、熹宗即位、正式追改年号、上谥及下葬，十月上谥确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003504",
      "reason": "陈奉被击伤的年月异说仍待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003505",
      "reason": "苏州民变的月日异说仍待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003509",
      "reason": "飞芬山和稗子谷的历史地望及明清实录不同纪日仍待核。"
    }
  ]
}
