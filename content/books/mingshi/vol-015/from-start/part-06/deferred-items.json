{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002160",
      "reason": "本纪注明召辅臣议政成为惯例，其后的具体频次待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002161",
      "reason": "小王子所指与战事地望待核。两日进攻分别录入。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002163",
      "reason": "都督杨玉稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002164",
      "reason": "送还陕巴与恢复朝贡是两件事，后续是否接受另有记载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002165",
      "reason": "各次赈济和贡使到达时间待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002168",
      "reason": "小王子稳定人物键及请求答复待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002169",
      "reason": "同名礼部尚书杨翥已于景泰年间去世。甘肃参将杨翥的稳定人物键及黑山地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002170",
      "reason": "王越用兵与徐溥致仕为同月两项行动，贺兰山战事详程待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002172",
      "reason": "清宁宫火灾、敕令修省、十二月赦令依时间分录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002174",
      "reason": "据历表核定本闰月为闰十一月。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002176",
      "reason": "各次税粮减免和贡使到达日期待核。"
    }
  ]
}
