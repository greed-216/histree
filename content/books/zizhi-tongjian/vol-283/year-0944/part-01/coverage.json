  "source_contexts": [
    {
      "source_key": "xinwudaishi-009-944-january",
      "note": "快照含全年本纪，本批仅用于正月记载，后续主线尚未录。"
    },
    {
      "source_key": "xinwudaishi-062-feng-name",
      "note": "复用已发布快照，敕令月份和允许奏事者与通鉴不同，独立并列，不将五鬼前事再次建档。"
    }
  ],
  "coverage": "卷283原93—103行11正文全部连续处理，后接卷284原6行二月；944全年跨两卷55段，未完成。",
  "source_issues_review": "丘甫遇据同日同职校皇甫遇；南唐奏事敕令月份及人选异说，秀谷秀容地点异文、伟王身份待核。博州周儒与晚唐同名人未强合。王周沿用938—942年主体，早期901同名连接留待身份复核，未重做旧批。纸本待核。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v283-y0944-p001",
      "note": "乙亥边报与己卯陷城分开；先是储粮免邵、通契丹等追述分时，吴峦任贝州由旧纪943年十一月补。丘甫遇校皇甫遇，不改底本；吴峦投井、城陷杀近万独记。王令温入朝质邵子、家属被俘与调邓州独补，未用传末评价替代动作。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p002",
      "note": "两地组奏报无具体攻入日；旧紀围忻代补地点，未添战果。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p003",
      "note": "母疾与荷恩是杨光远辩解；使者劝说、转奏及朝廷慰谕分开，信言不等已止反。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p004",
      "note": "两任职主体明确，与此前周宋党争及镇海任职分期。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p005",
      "note": "传位为意图，限制召见、上疏不报、贾哭谏及撤令分开。两书月份及可奏者有异说；徐景遂徐景达复用。高楼讽谏和贬舒守备为未确年追述，井典故不造古人参与。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p006",
      "note": "使者未通由新史王班补；帝石重贵，授赵官契丹德光。壬午先军与乙酉帝行、丁亥报告与戊子至澶分开。联合二万不翻倍，幽州道是行营名。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p007",
      "note": "遥领恢复不虚构未具名将相参与。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p008",
      "note": "孟派己亥由旧纪补，拒和回信非同日硬系；辛丑主书奏报新史战事区别，秀谷秀容异文并列，伟王姓名未明。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p009",
      "note": "铁钱一当百为名义币值，不推购买力或铸地。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p010",
      "note": "兄弟相争信、两方答与断交分开，古人比喻不参与；夺国是王延政指责。"
    },
    {
      "paragraph_id": "zztj-v283-y0944-p011",
      "note": "奏报动作与报告前事分开；周儒另档避免跨56年同名强合；殿直王班与909年已死襄州刺史分档，擒蔡不记死亡；窦警条件非已会师。"
    }
  ],
  "plain_language_review": "首次检查人物、事件标题正文、参与角色、关系与事实说明，动作主语写明；报告日、行动日、建议、许诺、引用中的指责和追述分别标注，原文保持。"
}
