[
  {
    "id": "zztj-v260-y0895-p001",
    "source_line": 6,
    "text": "春，正月，辛酉，幽州军民数万以麾盖歌鼓迎李克用入府舍；克用命李存审、刘仁恭将兵略定巡属。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_260_0895_keyong_welcomed_youzhou",
      "event_zztj_260_0895_cunshen_rengong_settle_youzhou_dependencies"
    ],
    "batch_key": "zztj-v260-y0895-p001-p005",
    "review": "正月辛酉迎府与命二将略巡属分录；承894进幽后事，数万为概数，略属不编县与路线。"
  },
  {
    "id": "zztj-v260-y0895-p002",
    "source_line": 7,
    "text": "癸未，硃全忠遣其将硃友恭围兗州，硃瑄自郓以兵粮救之，友恭设伏，败之于高梧，尽夺其饷，擒河东将安福顺、安福庆。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_260_0895_zhu_yougong_sieges_yanzhou",
      "event_zztj_260_0895_gaowu_relief_defeated_an_captured"
    ],
    "batch_key": "zztj-v260-y0895-p001-p005",
    "review": "癸未遣围与朱瑄援、友恭伏败夺粮擒安分阶段；旧史癸亥和高吴另引，不默改；被俘不作死。"
  },
  {
    "id": "zztj-v260-y0895-p003",
    "source_line": 8,
    "text": "己已，以给事中陆希声为户部侍郎、同平章事。希声，元方五世孙也。",
    "status": "published_verified",
    "event_keys": [
