    },
    {
      "person_id": "8f8c34eb-c238-596f-a688-8b8332b405a1",
      "name": "陈觉",
      "claim_id": "02ddab8b-5f3e-5525-a3ab-c54b444ca705",
      "quotation": "与孙晟及海陵陈觉谈议时事。",
      "citation": "卷277·长兴三年（932）·zztj-v277-y0932-p008·原文件第122行",
      "source_url": "https://github.com/greed-216/histree/blob/585a188b/content/books/zizhi-tongjian/vol-277/year-0932/part-01/sources/library/tongjian-277-932-february/source.txt",
