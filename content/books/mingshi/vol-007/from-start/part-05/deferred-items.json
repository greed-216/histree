    {
      "paragraph_id": "mingshi-2f603db3d81e-p001238",
      "reason": "荣昌伯陈智身份及车来地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001239",
      "reason": "鹿荣的规范人物键、具体用兵地点待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001240",
      "reason": "王愈等官员及误杀案相关人名、司法经过待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001241",
      "reason": "孟贤的规范人物键与同案人员待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001243",
      "reason": "其余诸将规范人物键及行军分工待核。安平伯李安的爵位异文见卷末校记。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001245",
      "reason": "保留明廷获悉阿鲁台战败的日期，瓦剌战斗本身的具体月日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001246",
      "reason": "封赐日期与归降先后可据连续文意，独立的受封日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001248",
      "reason": "年末来使实际到达日期、锡兰山王的规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001250",
      "reason": "郑和所使属于哪一航次及朝命、启程之间的时间待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001251",
      "reason": "陈英、朱勇、徐亨、孟瑛、薛禄、谭忠等的稳定人物键待核，金忠按受赐名的也先土干录入。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001252",
      "reason": "隰宁和答兰纳木儿河地望待核，原文所载仅为军中探报。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001253",
      "reason": "北征中的多日行动分录，军队颁令与朝廷实际执行细节待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001254",
      "reason": "答兰纳木儿河、白邙山地望与南京地震损失待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001255",
      "reason": "病重、死亡、送讣、迎丧、发丧、谥庙号各用原历时点。葬长陵的确日、太监马云与海寿的稳定人物键待核。"
    }
  ]
}
