  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003813",
      "reason": "河南指河南府，其他遇难者名录、黄陵城各将士伤亡待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003814",
      "reason": "召见名单、冉兴让出使与宗室获助确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003815",
      "reason": "郑崇俭处死日及八镇具体编制待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003817",
      "reason": "傅宗龙获释、赴任分别确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003818",
      "reason": "各省州县受灾情况、山东起事部属待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003819",
      "reason": "运河涸段和京师疫病范围、种类待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003820",
      "reason": "松山各部出战、撤军日程及信阳战确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003821",
      "reason": "九月各战地望、死亡确日与商水等地失守纪日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003824",
      "reason": "各地失守和开封围城起讫日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003826",
      "reason": "王裕民等官军平乱的确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003827",
      "reason": "洪承畴被俘、归降过程及遇难者各自纪日待考，保留本纪记载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003828",
      "reason": "魏照乘和魏炤乘为同人；含山等地各次确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003831",
      "reason": "后续出关、祭告、遣戍和两支援军溃散确日待核。"
    }
  ]
}
