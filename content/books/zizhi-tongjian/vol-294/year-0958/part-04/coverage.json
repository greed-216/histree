  "excluded_non_body": [],
  "coverage": "原30—41行连续十二段，后续未计。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v294-y0958-p025",
      "note": "配墓守户与先代祖墓照看为诏令，不造亡者在场及守户数量，检校是检查非官衔。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p026",
      "note": "辛亥派徐辽与四月癸丑实际献寿觞分开，旧补宴钱和五十伶官，不自推总人数或皇生日。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p027",
      "note": "三月浚汴口与通江淮为概述，无精确开竣日，不画现代河道。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p028",
      "note": "四月乙卯离扬与壬申到京分开。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p029",
      "note": "新庙成和庚申神主入，旧五庙神主不造活人边，不推五座独立新庙。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p030",
      "note": "辛酉夜火、壬戌威胁仓、王久病强救及自称疾愈，医疗说辞与史家民心概述均不作科学证。旧丁丑报十九火不是火发丁丑。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p031",
      "note": "契丹乘南征入侵为背景，壬申帝返京命御、旧甲戌张赴边为两个动作，职名分别保留。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p032",
      "note": "五月辛巳朔日食记载，无观测现代时分或天罚因果。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p033",
      "note": "主赏劳与旧按等第给军、战亡赠官子孙量才用、伤残救济、限定地区去年欠税分开，都是命令非每人已兑现。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p034",
      "note": "赵辛卯忠武仍殿前职与安青州平卢同日改镇，源既有同人不新增。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p035",
      "note": "郭崇东城克为报此前入寇，不定位现代城市或推全员动机。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p036",
      "note": "五月李璟景改名降号正朔告庙明确，三宰辅改职角色分清。初策论受宠、讥烈祖与赞现主、党相和、常屡谏为旧概述null；臣服后小朝讥是言论，未给党成员名单，不造古尧舜在场。"
    }
  ],
  "source_issues_review": "钱塘火原纪日与旧报告十九分别保留，王自称病愈非医疗事实。李璟景已核别名不新建，前后诏令与落实区分。检得新史吴越世家p003377另明尹日就957年出使、958陆归，前批未知派使年可后续独立补证，不改已发档案。纸本和地理待核。",
  "pending_supplements": [
    {
      "primary_paragraph_id": "zztj-v294-y0958-p006",
      "source_paragraph_id": "xin-wudaishi-b08f244b9241-p003377",
      "subject_key": "person_尹日就",
      "note": "新史明确显德四年派尹、五年克静海后陆归；保留待补，不将前批档案直接覆写。"
    }
  ],
  "plain_language_review": "首次逐条检查标题、事件正文、人物参与角色和事实解释。派使与行礼、离京与抵京、诏令与实施、降号与改名、言论与史实、疾病说辞与医疗因果均分清。古帝和已亡者不造在场，引用原字保留，普通说明明确主语。"
}
