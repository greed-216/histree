{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002034",
      "reason": "小王子、指挥姚英的稳定人物键与战事地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002036",
      "reason": "古来来奔、请封、后续册封各有阶段，卷324另记经过。具体来奔路径待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002038",
      "reason": "各次贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002041",
      "reason": "边镛和田景贤的规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002042",
      "reason": "同科进士的其他名次待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002044",
      "reason": "正文五月、校记六月己巳两说均保存。朵颜三卫入辽东的实际日期及那孩身份待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002046",
      "reason": "雍王本纪作祐橒、卷119作祐枟。五位册封同日，受封后出府日期待各自传记。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002047",
      "reason": "疾病、皇太子摄事、去世、上谥、葬茂陵分录；葬日以卷十五十二月壬午核定。享年照录原书记法。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002049",
      "reason": "赞语的评判保留原文。两件能回连的既有史事补出处；黎淳、商辂等指涉及具体褒贬仍由对应正文查证。"
    }
  ]
}
