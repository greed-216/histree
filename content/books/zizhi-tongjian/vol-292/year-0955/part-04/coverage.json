  "coverage": "原57—63行连续七段，含六段史事及一段司马光史论；下一段南唐与淮南部署待录。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v292-y0955-p025",
      "note": "罢判三司与随后父丧罢政事分开，丁未只确定前者；旧史同日印证。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p026",
      "note": "八月获三百与九月辛卯送俘抵京分开，不能由人数自行认定名单完全相同；伊审征慰劳督战为派遣任务。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p027",
      "note": "县官指官府；设监命令、铜器征收例外期限给价、逾期隐匿处罚和柴荣解释讲话均完整处理。五斤不换算，刑罚不造已执行个案。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p028",
      "note": "司马光史论归柴荣人物评价，只有引用无955年事件，不虚构评论日期。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p029",
      "note": "部署、黄花唐仓战、撤退、弃城降城、任官与庆功分层。王峦同名暂分，俘三千与一千五百余及死俘异说保留；旧纪壬子奏报和癸丑归降与主书记序分别保存。宋传赵玭前史孟知祥时序疑问不导入任官确年。凤州仍未最终攻克。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p030",
      "note": "万岁殿讲话作为责任表态，不当本段已亲征。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p031",
      "note": "李廷珪与伊审征请罪跨闰月十月，宽免承接两人；请和未答不是和约。剑门白帝备守与铁钱铁器榷管分开，不虚构兑换价格。"
    }
  ],
  "source_issues_review": "黄花俘虏数、王峦生死、秦州降城与庆功时序并列；王峦同名暂分，赵比异字不自动追加别名，判宫等疑字保留。宋赵玭传孟知祥任官时序可疑，不据疑叙入确年。纸本待核。",
  "plain_language_review": "首次逐条核对标题、人物说明、参与角色、事件正文、时间与事实解释为现代白话。诏令条件、讲话观点、史家评论、愿望与实际行动分开；原文保留。"
