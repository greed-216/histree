    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002918",
      "reason": "玉芝宫营建确日另考，原条只记此前祭告及随后营建。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002921",
      "reason": "贡使到达日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002923",
      "reason": "本纪在二月癸亥条连记上疏与下狱；《世宗实录》称相隔数月，海瑞自述上疏在四十四年十月，原疏递呈和下狱确日及不同史料异说留待对照。俞大猷广东行动和婺源攻陷各自确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002928",
      "reason": "两地来军具体部属与郭江规范人物键待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002929",
      "reason": "崔世荣规范人物键与来军具体部属待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002930",
      "reason": "遗诏继承与正式登基是两件事，登基另见卷十九壬子。葬永陵据穆宗本纪核为三月，明确区分正月上谥。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002938",
      "reason": "土木战事董国忠和陈国忠称名未决，待继续校核真实姓氏及稳定人物键。"
    }
