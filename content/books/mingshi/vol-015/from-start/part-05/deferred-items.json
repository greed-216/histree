  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002139",
      "reason": "太皇太后为此前已尊太皇太后的周氏。小王子具体指称和凉州战地待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002140",
      "reason": "黄陵冈河口工程和此前张秋治河各有完工记载，工程起讫范围待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002144",
      "reason": "杨时为宋人，此处所录是明廷追封。从祀相关礼仪和欧磐稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002147",
      "reason": "土鲁番各部撤退、明军班师的独立日期和路线待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002148",
      "reason": "各次使者到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002151",
      "reason": "张璞、马中锡稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002152",
      "reason": "朱希周稳定人物键及同科进士名单待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002153",
      "reason": "刘逊被逮日有四月戊子，庞泮等下狱与获释日期另待核。卷180列传记相关人数和申救者。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002156",
      "reason": "卷末校记有本条文字校订，后续保留校记作为证据。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002157",
      "reason": "原文作疏球，白话规范为琉球。具体来贡日期待核。"
    }
  ]
}
