    },
    {
      "id": "mingshi-2f603db3d81e-p001588",
      "book_key": "mingshi",
      "book": "明史",
      "source_version": "2f603db3d81e",
      "section_id": "mingshi-2f603db3d81e-s0011",
      "section_title": "卷十",
      "section_kind": "volume",
      "volume_candidate": 10,
      "volume_part": "",
      "volume_verified": false,
      "structural_volume_verified": true,
      "kind": "body",
      "text": "六月庚戌，靖州苗犯辰溪，都指揮高亮戰死。丙辰，南京謹身諸殿災。甲子，修省。詔河南、山西班軍番休者盡赴大同、宣府。乙丑，西寧侯宋瑛總督大同兵馬。己巳，赦天下。戊寅，平鄉伯陳懷，駙馬都尉井源，都督王貴、吳克勤，太監林壽，分練京軍於大同、宣府，備瓦剌。",
      "boundary_basis": "epub_source_paragraph",
      "review_status": "pending",
      "flags": [],
      "locator": {
        "source_file": "resources/originals/twenty-four-histories/24明史-EPUB全文.txt",
