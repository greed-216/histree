{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001811",
      "reason": "宪宗曾用名见濬，不与卷十二天顺元年封吉王的见浚混同。改名确日待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001813",
      "reason": "依本纪拆分去世、继位、预定次年改元、撤官及召还；各地撤官执行确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001814",
      "reason": "具体所授何官及内批制度另查职官志。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001815",
      "reason": "两位皇太后分记。彭教稳定人物键、获授进士等其余名单待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001816",
      "reason": "记录日食当食未见，观测原因及各地可见性待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001817",
      "reason": "天顺八年五月庚申葬裕陵有明确日，与卷十二二月上尊谥分立。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001819",
      "reason": "牛玉下狱独立确日及吴后被废说法另核卷113。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001822",
      "reason": "各地动乱与道路受阻范围、贡使到达日期原文未逐项记。"
    }
  ]
}
