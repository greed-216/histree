  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002286",
      "reason": "其余受杖官员的稳定人物键及同案人员待核。历表证本闰月为闰正月。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002287",
      "reason": "王良臣和王时中的稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002288",
      "reason": "结党为当时朝廷指控，其他人身份和处分情况待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002289",
      "reason": "度僧道数字照本纪。宁王护卫在正德五年又被革除，续录见后段。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002292",
      "reason": "各边巡抚和管粮郎中名单待核。杨廷和十月兼文渊阁大学士与年表同月条对应。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002294",
      "reason": "贡使具体到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002296",
      "reason": "杨南金稳定人物键和中旨如何形成待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002298",
      "reason": "其他同科人员名单待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002300",
      "reason": "匿名文书案顺序据本纪和卷末校记。拘系及获释确日待核，人数用本纪所载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002302",
      "reason": "山东起事者身份、具体地点和时间待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002303",
      "reason": "雍泰稳定人物键与刘大夏实际启程戍边日期待核。削籍和下狱按原历分开。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002306",
      "reason": "各次贡使到达日期待核。"
    }
  ]
}
