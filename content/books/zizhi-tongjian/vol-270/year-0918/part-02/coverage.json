  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v270-y0918-p005",
      "note": "《旧五代史》将谢彦章逼杨刘系于二月，后段六月交战不得混入本段；安彦之本人不作归晋。"
    },
    {
      "paragraph_id": "zztj-v270-y0918-p006",
      "note": "己亥在本年二月与三月条之间，主书未再次标月；不反推公历日。"
    },
    {
      "paragraph_id": "zztj-v270-y0918-p009",
      "note": "岐求好只记使者来往，未推定蜀接受。"
    },
    {
      "paragraph_id": "zztj-v270-y0918-p011",
      "note": "高万金死日未明；《旧五代史》另记高万兴为其兄，关系复用。"
    }
  ]
