  "coverage": "卷284原76—86行连续第25—35段，五月至七月末及追述，卷284正文结束。945年仍须接卷285前23段，全年未完成。",
  "source_contexts": [
    {
      "source_key": "tongjian-284-945-may-july",
      "note": "对应25—33段，长期与后来谈话均按原文区分时间。"
    },
    {
      "source_key": "tongjian-284-945-july-ending",
      "note": "对应34—35段；卷末空行并未算正文。"
    },
    {
      "source_key": "xinwudaishi-068-li-ren-da",
      "note": "只补杀卓与李受官改名，建州破与王迁留到下一卷主线；传末保大四年不裁全段年份。"
    },
    {
      "source_key": "jiuwudaishi-109-du-leaves",
      "note": "只补恒州不救与擅离；其他未来降敌、后汉反叛等未提前录入。"
    },
    {
      "source_key": "jiuwudaishi-109-du-wife",
      "note": "只补长期税外征敛及妻为晋高祖妹、宋国公主身份，未重录早年同事。"
    },
    {
      "source_key": "jiuwudaishi-084-945-june",
      "note": "只补同日杜任邺留守与马继任恒州，后续马卒暂留。"
    },
    {
      "source_key": "jiuwudaishi-084-945-august",
      "note": "只补马希杲死亡奏报日，其他八月事留下一卷。"
    },
    {
      "source_key": "xinwudaishi-029-jing-peace",
      "note": "只补张晖使者与求和条件、停止，景延广后来中渡事未提前录入。"
    }
  ],
  "source_issues_review": "私用字、人数千百千萬、新史保大四年与主书编年、军号扈圣护国和死亡奏报日区别均保留具体校核说明；未校纸本。卓死亡、李改名、公主异封号与马死亡以新事实引用补充，不改旧发布档案。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v284-y0945-p025",
      "note": "五月大赦与四月京城赦囚分开，主新旧纪日一致。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p026",
      "note": "长期征敛、掳女、闭城未救与五月入朝请求分开，不把久镇强定本年；私用字保留于原文，解释不校字；主千百旧千萬并列。公主按杜妻与高祖妹身份对应乐平公主，旧传补宋国封号。辞位是请求非本月已罢相。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p027",
      "note": "阅兵诱杀、假惊走与被推上座、留后自称、唐晋两边外交、杀未名父、南唐官命、赐名宗籍、修好吴越分开；李仁达非亲手刺僧，编属籍不推血缘。卓岩儼异名承前；新史传末保大四年不套全段。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p028",
      "note": "献步骑甲仗、报献尚在本道的粮草、皇帝隶军、请自留牙队由朝廷支付、借妻求节钺分阶段，未将报告写成到账；扈圣护国按底本，不擅校军名。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p029",
      "note": "围建破泉州、许破唐军和俘时厚卿分开；俘不等于死，不补具名围城将。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p030",
      "note": "六月癸酉正式任命区别五月请准，旧纪补邺都留守与马接恒州，未提前马全节卒。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p031",
      "note": "两国战争损耗为长期背景，母子假设、态度与臣下议和分别注明说话人；景桑赴契丹与镇定割地均为要求非执行，停止求和与后来入梁谈话分开；张晖限后晋使者身份，未自动合博州或北汉同名人。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p032",
      "note": "谋叛是有人指控不作已叛确证；缴械、遣还、伏杀八千余与制肉干分开，未知隘口不补坐标、未名者不造人。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p033",
      "note": "镡不混潭；三人赞攻与军需府库民生后果分开，集团称呼不建无证盟友关系。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p034",
      "note": "称臣、请附庸与求援是王延政主动请求，不推吴越已准或已出兵。"
    },
    {
      "paragraph_id": "zztj-v284-y0945-p035",
      "note": "疑得人心、派监视、称疾求归遭拒、遣医毒杀分开；七月叙死与八月戊子奏报不同，保留具体日期角色。"
    }
  ],
  "plain_language_review": "首次逐条阅读标题、描述、参与、时间与事实说明，简体白话、明确主语。计划、请求、指控、奏报、长期背景与后来追叙均与实际行动分开。引用保留底本原字，无二次全面重写旧批次。"
}
