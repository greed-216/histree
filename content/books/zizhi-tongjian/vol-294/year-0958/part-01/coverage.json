  "coverage": "原6—13行首八段，后续未计。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v294-y0958-p001",
      "note": "废军为军镇建制，旧同日同州降郡，不推军士命运。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p002",
      "note": "主正月中兴与新交泰元年正月合叙分源，三月交泰另待后段，不改年号原文。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p003",
      "note": "丁亥主奏克、新取，旧丙戌奏攻，日期措辞并列，非真实战日独证。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p004",
      "note": "己丑权扬州军府为代理非正式节度职。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p005",
      "note": "舰阻堰、计划凿水、使者报困难、帝亲察规划、征民旬成百舰通江分阶段；旧庚寅发丁壮补起令，旬日不倒算精确竣工，神为当时惊叹非神迹。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p006",
      "note": "壬辰静海被取与通吴越，先是泛海派尹及预测、后来应验分开，派使和归期year null不硬定壬辰。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p007",
      "note": "章九龄不同唐张九龄，指控与贬职分清，被指两臣不当在场。楚围四旬跨年、乙巳亲攻、主新丁未与旧丙午克城、千余守军死不降、旧万余军民大掠杀焚独立记录。旧引陆游光祐存活与赵引未名儿被父斩不合一，父亲方向明，引用依赖注明。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p008",
      "note": "高保融魏璘百舰出兵抵鄂，主年初叙与旧三月丁酉奏分清，未强出兵当天已会战。"
    }
  ],
  "source_issues_review": "海州丁亥丙戌及攻克措辞、楚州丁未丙午克日、年号中兴交泰叙法各保异说。千余守军与万余军民不混统计，既录军纪也保杀掠。旧引书依赖明确，光祐不认成未具名劝降被杀子。纸本及地理待核。",
  "plain_language_review": "首次逐条核对标题正文、人物角色、父亲方向及事实解释；计划与完工、奏日与战日、权代理与正式任命、跨年围城与具体克城分清。主语指控和惊叹标明来源，匿名人物不补造，来源字形保持不变。"
}
