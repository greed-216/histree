  "coverage": "卷287原14—21行连续八段，本卷累计16/75；947年跨卷尚未完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v287-y0947-p009",
      "note": "奏报日与攻城、撤回建议、劝降和暂管州事分别整理；直接《宋史》补证，不以夹注转引冒充独立原文。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p010",
      "note": "张遇战败死亡、武行德失利、劝止攻城、北逃劫掠与会合依序录入；军法事实与史家评价分清，入洛汴总结不提前定日。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p011",
      "note": "辛丑到霍邑及通报赵延寿被拘押，复用前段拘押主体，不重复事件。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p012",
      "note": "宦官张环与渝州刺史分别建档，仅用限定别名；强夺宫人与用刑杀人分录，人数保留约数。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p013",
      "note": "迫迎、拥立、任官、守门、离汴、召将、议守与称臣依序录入；王淑妃不推生母；王松父名徽主体待核；萧翰壬寅与己亥异说保留；拒守提议与实际投表分清。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p014",
      "note": "甲辰到晋州，区别前卷任命晋州官职。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p015",
      "note": "自行继位不安为史家解释；未名皇子不猜主体；太后授权异说保留。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p016",
      "note": "阿保机去世及述律平杀将为旧事，复用既有事件；北归动机、任官、人员留随与乙巳启程分录。"
    }
  ],
  "source_issues_review": "保留萧翰离汴纪日差异、王松父亲身份待考；旧事日期沿既有事件；养母与同名宦官明确区分，未消除其他异文。",
  "plain_language_review": "首次逐项核对人物、事件、参与角色、时间地点、出处与事实说明；说明计划、预测、指控、史家评价和实际行动，展示字段用白话，逐字引用保持底本。"
