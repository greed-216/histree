  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001599",
      "reason": "卷首谱系及首封按本纪范围校核。恭仁康定为后来的谥号，具体追尊沿卷末另录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001601",
      "reason": "陈懋奉诏回师、诸军实际入京及运输日期待核，商辂、彭时同月入阁分条复用旧记录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001602",
      "reason": "季铎所传具体内容与上皇收悉日期待核。处州余部后续仍有活动。张安、王清、陈友、杨信民稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001603",
      "reason": "请朝鲜出兵仅据诏命，实际回应待考。王复、赵荣之名按本纪校记并核王复传。京城附近各场战斗、守将与俘行地望待进一步核对。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001604",
      "reason": "耿九畴抚安对象范围和修关各处地点待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001605",
      "reason": "孟鉴、柳溥稳定人物键和赴任日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001606",
      "reason": "年度回顾原文未载各贡使到达确日。"
    }
  ]
}
