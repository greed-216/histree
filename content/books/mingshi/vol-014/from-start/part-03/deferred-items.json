      "paragraph_id": "mingshi-2f603db3d81e-p001970",
      "reason": "卷304汪直传对出兵缘起另有记述，保留本纪所载朝命。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001971",
      "reason": "威宁海子之战卷171、173另记行军与各部参与，此处保留本纪明载的人员。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001975",
      "reason": "战事中的具体路径及广西陈政的稳定人物键待核。十二月对应公元1481年。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001976",
      "reason": "各次贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001980",
      "reason": "其余科举名录待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001981",
      "reason": "五年审录的后续具体期次及首次审录确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001982",
      "reason": "本纪记调兵御敌；七卿年表记王越同月出镇宁夏，留作同月不同内容的记录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001986",
      "reason": "各次贡使日期、进攻与敕谕各自日期待考；卷321安南传另有相关经过。"
    }
  ]
}
