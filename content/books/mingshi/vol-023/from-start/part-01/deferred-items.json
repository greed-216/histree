  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003613",
      "reason": "出生农历月份覆盖公元1611年，具体生辰未径取月首；出居信邸的确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003615",
      "reason": "受遗命确日和宫中过程待考。即位仍称天启七年，次年才改元。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003618",
      "reason": "被释放的诸臣家属完整名单待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003619",
      "reason": "校记[1]订周道登为正字，任命的具体日及实际到任分别待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003623",
      "reason": "抚恤各人的身份和所赠品级待考。用此段确验卷22附记的德陵葬日。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003624",
      "reason": "刘若宰之外的同榜名单待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003627",
      "reason": "浙江水灾各地损失、漂没人数和统计范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003630",
      "reason": "刘鸿训被遣戍的确日待考，本纪作“寻”。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003633",
      "reason": "各边部取消赏赐与粮食请求的分次确日，以及陕西起事分路史实待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003635",
      "reason": "逆案六等的完整名单、题名和随后执行另考。"
    }
  ]
}
