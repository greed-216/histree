{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003854",
      "reason": "南京地震、张献忠入川各自日期待考。范景文、丘瑜授命与实际到任的纪月差异保留。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003855",
      "reason": "赵王常㳛被俘或投降有异，高起潜等十人名单、宁武关各次战斗日及各藩王下落待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003856",
      "reason": "按三月己丑朔区分庚寅初二、丙午十八、丁未十九。各位官员遇难日、帝后入葬日期及衣襟文字版本仍待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003857",
      "reason": "山海关战事参战人员及分日，本段只给农历四月。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003858",
      "reason": "入京、以帝礼改葬、臣民服丧、赐谥及陵名的独立日期待分别核查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003862",
      "reason": "梓潼战的正月、二月异说并存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003863",
      "reason": "卢象升被罢的两种纪日仍存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003864",
      "reason": "罗猴山异写及地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003865",
      "reason": "杨嗣昌督师有七、八、九月异说。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003866",
      "reason": "左良玉受封将军有跨年异说。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003867",
      "reason": "玛瑙山七日戊午依校记订正，丙辰另可能记会师。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003869",
      "reason": "黄絅照校记订名，黄炯为旧文。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003870",
      "reason": "赵王姓名据校记，投降或被执的各书记法均保存。"
    }
  ]
}
