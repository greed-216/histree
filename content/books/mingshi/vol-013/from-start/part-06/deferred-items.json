  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001866",
      "reason": "胡柴沟具体地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001867",
      "reason": "宋旻、曾翚、黄琛、滕昭的规范键和分赴地区待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001868",
      "reason": "傅恭和顾恒身份及募兵事务细节待核。依本纪不用屯田诏确日推定各项任命确日。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001871",
      "reason": "李昹、房能规范键待核。开荒川之战在卷171王越传及卷173朱永传所述详略、归功有别，保留本纪说法。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001874",
      "reason": "此次荆襄起事各首领、孛罗忽渡河具体日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001875",
      "reason": "十四名使者及各自分派地点待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001876",
      "reason": "各地贡使到达日期待核。"
    }
  ]
}
