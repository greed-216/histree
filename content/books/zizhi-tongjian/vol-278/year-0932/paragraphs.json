    "review": ""
  },
  {
    "id": "zztj-v278-y0932-p026",
    "book": "资治通鉴",
    "volume": 278,
    "year": 932,
    "source_line": 31,
    "text": "石敬瑭至晋阳，以部将刘知远、周瑰为都押衙，委以心腹；军事委知远，帑藏委瑰。瑰，晋阳人也。",
    "status": "pending",
    "event_keys": [],
    "batch_key": null,
    "review": ""
  },
  {
    "id": "zztj-v278-y0932-p027",
    "book": "资治通鉴",
    "volume": 278,
    "year": 932,
    "source_line": 32,
    "text": "十二月，戊午，以康义诚为河阳节度使，兼侍卫亲军马步都指挥使；以硃弘昭为山南东道节度使。",
