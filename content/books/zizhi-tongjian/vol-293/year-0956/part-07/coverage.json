  "excluded_non_body": [],
  "coverage": "原54—62行最后九段；956年跨卷审计通过后才记整年完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v293-y0956-p049",
      "note": "太祖皇帝为赵匡胤，不是郭威；定国军号与旧史同州称法并存，赵普上表推荐不当作独立到任证。"
    },
    {
      "paragraph_id": "zztj-v293-y0956-p050",
      "note": "密报二心是张永德指控，柴荣不信；单骑解疑与蜡书诱约、呈报分阶段，肺腑不创建二将血缘关系。"
    },
    {
      "paragraph_id": "zztj-v293-y0956-p051",
      "note": "初为旧接待，问讯拒答、十一月乙巳处刑与百余随从杀、钟谟贬逐和后来召授拆开。既而召回日期不明留null，孙晟的忠节评价标源。"
    },
    {
      "paragraph_id": "zztj-v293-y0956-p052",
      "note": "飞升黄白术是问询，不认可神术为事实；宋补授谏议而拒，留月余不算起日。戊申放还旧史同日，宋958赐茶帛留待后年。"
    },
    {
      "paragraph_id": "zztj-v293-y0956-p053",
      "note": "十二月壬申授职，点校与点检字样各保原文。"
    },
    {
      "paragraph_id": "zztj-v293-y0956-p054",
      "note": "多州数万丁夫为概数，城是筑城动作，不写竣工日；旧史少列兖保留差别。"
    },
    {
      "paragraph_id": "zztj-v293-y0956-p055",
      "note": "停最害民营田不是全部废除，求援与未出兵留使分开，久之责问年不明留null；反间与外援意图不当成功事实。"
    },
    {
      "paragraph_id": "zztj-v293-y0956-p056",
      "note": "獠保留史称，现代民族、战日和人数未载，不补。"
    },
    {
      "paragraph_id": "zztj-v293-y0956-p057",
      "note": "弘亻叔按在位者钱弘俶识别，民捕异常字不擅改民船，不确定征括具体对象；钱弘亿劝谏及停止可确定。"
    }
  ],
  "source_issues_review": "弘亻叔字形异常按身份识别钱弘俶；民捕对象待校，引用原保，不擅改民船。殿前都点校与点检各保本字。接待与久留追述不强定本年，纸本及异文待核。",
  "plain_language_review": "首次逐条检查标题人物、事件角色和事实解释。指控、劝谏、神术传闻、求援与实际行动分清；匿名随从丁夫不造名单，未知日留空，内部简称不展示，原文按快照逐字核验。"
}
