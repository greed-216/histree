  "pending_paragraphs": [
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001264",
      "observations": [
        "已录父母和受册为燕世子。梦兆与史载品行保留在原文，阅卫士、阅奏与问水旱的确日待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001265",
      "observations": [
        "守北平兵数系本卷说法；召还和立储月次与卷六有差别。黄俨及其党身份、北平居守与诸次监国细节待补。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001267",
      "observations": [
        "卷八所系永乐十年与卷七和年表的十二年闰九月不同。其余指控、调查、建立或处置各人的日期与身份待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001269",
      "observations": [
        "夏原吉、吴中释狱与复职逐项回查，南北军镇人物身份与杨溥任命确日待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001270",
      "observations": [
        "清化阵亡陈忠的官职见卷末校记，陈忠、伍云、萧奇等稳定人物键及茶笼州地望待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001271",
      "observations": [
        "八王封爵保留原名，规范人物键、具体日期及月廪日次校勘待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001272",
      "observations": [
        "建文官属及所涉亲属的后续赦宥另有十二月政策，各户身份、羁管及财产个案待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001273",
      "observations": [
        "十二月宽免外亲，见卷末校记；其他抚恤范围与顾兴祖征讨地点待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001274",
      "observations": [
        "各次来贡具体人名日期待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001276",
      "observations": [
        "南畿和浙江巡视者规范人物键及弘文阁入直官员待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001277",
      "observations": [
        "郑和任命确日、边将名单和南京各次地震确日待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001278",
      "observations": [
        "继续核对刑诏各条执行情况、陈智与薛禄规范人物键，以及还都计划的后续。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001279",
      "observations": [
        "减税地域、具体粮种及南京地震确日待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001280",
      "observations": [
        "李时勉、罗汝敬下狱确日、仁宗安葬确日及罗汝敬稳定人物键待核。"
      ]
    }
  ],
