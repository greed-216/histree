# Local MySQL 8; initialize with database/mysql/*.sql. Server only.
HISTREE_DATABASE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=histree
MYSQL_USER=histree
MYSQL_PASSWORD=
MYSQL_SSL_MODE=disabled
PORT=3000
HISTREE_ASK_ENABLED=false
DEEPSEEK_API_KEY=
HISTREE_MODEL=deepseek-flash
HISTREE_GATEWAY_SECRET=
HISTREE_ALLOW_ANONYMOUS=true
HISTREE_AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only behind one trusted nginx proxy.
TRUST_PROXY=0
# OSS images: private bucket, public images namespace served by the API.
HISTREE_OSS_BUCKET=
HISTREE_OSS_REGION=oss-cn-beijing
HISTREE_OSS_INTERNAL=false
HISTREE_OSS_CREDENTIAL_TYPE=ecs_ram_role
HISTREE_OSS_ROLE_NAME=HistreeOssImagesRole
# Local tooling only: use a dedicated least-privilege RAM identity or STS.
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_SECURITY_TOKEN=
