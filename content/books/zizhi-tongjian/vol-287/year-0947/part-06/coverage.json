  "coverage": "卷287原46—53行连续八段，本卷累计48/75；947年跨卷累计140/167，尚未完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v287-y0947-p041",
      "note": "撤兵与归降分录，即日仅指杨衮闻讯当日。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p042",
      "note": "庚寅任官、刘铎举州降、薛诈入杀害、报克复与知而不问分清；己酉仅为旧史奏报日，说辞与任前职名异文保留。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p043",
      "note": "恢复州军名、乙未正式授任与地方暂掌区别；逾年授何李官职确年未载为null，宋传叙事次序并列，不指定授任皇帝。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p044",
      "note": "全族处斩为草案，反对后只删全族；17为村数，新史数百为死亡约数；法令丙申不套杀民日期。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p045",
      "note": "静狱令与苏尽杀囚区分，往事确年未载为null；军旅与庶务委任、史家评价与家事分录；杀兄密告郭威与密告高祖异说保留，未认定郭威亲自行刑。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p046",
      "note": "希崇指控遗命不当已证实事实；永州与朗州、趺石与砆石异文保留；卸甲住宫禁见、杀议被拒、赠归与情报内应分录，分治愿望不当已分国。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p047",
      "note": "契丹灭晋带走马与后汉八月购买民马分开，河南不用现代省界。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p048",
      "note": "正式朝廷授官区别六月实际继位，未虚构授官干支。"
    }
  ],
  "source_issues_review": "杀刘铎诈入说辞、苏逢吉杀兄密告对象、马希萼奔丧出发地及趺砆字形保留异说；何李逾年授官确年未定。平阴十七为村数，数百为史载约数。",
  "plain_language_review": "首次检查人物、事件、参与、关系及事实说明，明确主语；草案、提议与实际结果分开，追叙确年未知为null，逐字摘录保持原字。"
}
