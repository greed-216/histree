      "claim_id": "e4dfde21-d000-57b4-9dbe-2cc07cf1a03c",
      "source_url": "https://github.com/greed-216/histree/blob/5f4233fa/content/books/zizhi-tongjian/vol-279/year-0934/part-08/sources/library/tongjian-279-934-meng-name-decree/source.txt",
      "source_path": "content/books/zizhi-tongjian/vol-279/year-0934/part-08/sources/library/tongjian-279-934-meng-name-decree/source.txt",
      "source_sha256": "1a04f1da4283be291ec59c72b6ea8c759c2360b257fafff8269abd346aaa8710",
      "verbatim_excerpt": "蜀主令继勋等与赵季良，赵廷隐谋，"
    },
