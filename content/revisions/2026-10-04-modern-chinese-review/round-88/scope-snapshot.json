    "fact_claim": [
      {
        "id": "44992053-9dee-5a47-bda3-5b53a14fdc02",
        "subject_table": "person",
        "subject_id": "d32759c6-52a0-5cfd-a2e9-64b5eda43628",
        "field_path": "description",
        "claim_text": "本段记王弘贽：阶州刺史、绕袭领兵者。",
        "source_id": "77f0a93b-8ac8-540d-9458-812bd311e8c3",
        "citation": "卷277·长兴元年（930）·zztj-v277-y0930-p048·原文件第53行",
        "note": "原文：阶州刺史王经贽、泸州刺史冯晖与前锋马步都虞候王思同、步军都指挥使赵在礼引兵出人头山后，过剑门之南，还袭剑门，；核对说明：核对人物姓名、职务和行动后识别为同一主体；展示使用简体，引用保持底本原字。",
        "status": "published",
        "source": {
          "id": "77f0a93b-8ac8-540d-9458-812bd311e8c3",
          "url": "https://github.com/greed-216/histree/blob/73f70bd8/content/books/zizhi-tongjian/vol-277/year-0930/part-04/sources/library/tongjian-277-930-autumn-winter/source.txt",
          "title": "资治通鉴·后唐纪六"
        }
      }
    ]
  },
  "evidence": [
    {
      "id": "029d3016-b33a-59a1-9876-1807c06ff51f",
      "subject_table": "person",
      "subject_id": "d1e178c5-2867-5a9a-975a-99d904b9d46b",
      "field_path": "description",
      "claim_text": "《资治通鉴》认为孟汉琼等人挑起猜疑、离间，使李从厚遭遇祸败。这是史家的归因。",
      "source_id": "1485b364-457c-5594-acb5-25ae2baca6b4",
      "citation": "卷279·清泰元年（934；四月条下，改元前为应顺元年）·zztj-v279-y0934-p023·原文件第28行",
      "note": "原文：闵帝性仁厚，于兄弟敦睦，虽遭秦王忌疾，闵帝坦怀待之，卒免于患。及嗣位，于潞王亦无嫌，而硃弘昭、孟汉琼之徒横生猜间，闵帝不能违，以致祸败焉。；核对说明：这是史家对前事的评价或归因，不建立确定因果关系，也不把此前已死的人写成当场杀害李从厚的执行者。",
      "status": "published",
      "source": {
        "id": "1485b364-457c-5594-acb5-25ae2baca6b4",
        "url": "https://github.com/greed-216/histree/blob/8468a699/content/books/zizhi-tongjian/vol-279/year-0934/part-05/sources/library/tongjian-279-934-accession-aftermath/source.txt",
        "title": "资治通鉴·后唐纪八"
      }
    },
    {
      "id": "0672bc44-4b04-589d-9a18-2cf7ea9ba827",
      "subject_table": "event",
      "subject_id": "ec05f079-589d-52cc-b43c-d113c304f378",
      "field_path": "description",
      "claim_text": "《新五代史》末帝纪在戊寅记李从厚被杀，并记宋令询因此去世，刺史州名写作慈州。",
      "source_id": "98eadb33-eb5f-574c-953f-598b8b39c079",
      "citation": "《新五代史》卷七，段落 xin-wudaishi-b08f244b9241-p000300；EPUB电子本，纸本及异文待核",
      "note": "原文：戊寅，弒鄂王，〈義與「弒濟陰王」同。〉慈州刺史宋令詢死之。；核对说明：帝纪支持被杀和纪日，不独立证明勒死方法。慈、磁字形差异保留在各书原文中。",
      "status": "published",
      "source": {
        "id": "98eadb33-eb5f-574c-953f-598b8b39c079",
        "url": "https://github.com/greed-216/histree/blob/d4437e45/content/books/zizhi-tongjian/vol-279/year-0934/part-04/sources/library/xinwudaishi-008-congke-eastmarch/source.txt",
        "title": "新五代史·卷七"
      }
    },
    {
