  "coverage": "原50—57行连续八段，后续未计。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v294-y0958-p045",
      "note": "辛巳中宗即已核刘弘熙晟卒，子继兴鋹沿旧主体。十六与父三十九史载年龄不倒算生年；龚卢掌政与台省备位为史家格局评价非全员永无政事。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p046",
      "note": "甲申进奏院是驻朝联络，不作迁都。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p047",
      "note": "壬辰命使甲具件数不当兵数；曹籍字父芸与此前履宋补，张贵妃从母非生母。拒礼追数四、籍呈、帝准取、分亲旧家无留分阶段，缺闭引号引用保原不修。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p048",
      "note": "八月辛丑返使命谢请传位、九月丁巳两授职、己未钟先返、殷贺节分开。旧并放归是程序合叙与主十月冯返各保，商殷汤姓名阶段不混，父母恩是政治修辞不造生父关系。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p049",
      "note": "己卯拟伐高制置李判与旧转运使名称详略、发粮准备分开；甲午三降将和冯返，周廷延构同任务异字。唐弃三将非冯也是败军俘，也非已杀。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p050",
      "note": "高再次书、集議誓言、丁酉命拒函分明，不造诸将名单或已经全战死。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p051",
      "note": "派三十四人使均租与旧六十州范围，艾颍颖异文保留。庚子百户团三耆为诏制，木耕蚕为宫中关注，不实务入田；宋秋巡无军数不搬春三千。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p052",
      "note": "高请水军趋三峡与诏褒非已参战，未来伐蜀不得当已克。"
    }
  ],
  "source_issues_review": "曹彬礼事缺引号原保，冯归九十月程序、商殷汤与周廷延构、艾颍穎、转运制置官名各保异文。南汉年龄不推现代出生年，政策诏与执行不混，纸本地理待核。",
  "plain_language_review": "首次逐条检查人物角色、父亲方向、标题正文及事实解释。元号姓名同人、死赠与生任、拒礼与转交、请求传位与不准、拟战与已战、规定户数与实测户数分清；政权概述不作每人普查，引用保原。"
}
