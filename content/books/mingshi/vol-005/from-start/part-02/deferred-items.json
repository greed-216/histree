  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000953",
      "reason": "卷五系蔚州陷于正月，卷四二月条合记，保留两卷月份。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000954",
      "reason": "暂保留朱棣、李景隆进退和冻馁人数的卷五叙述，具体日期与人员范围待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000955",
      "reason": "白沟河按两天分录。不同叙事中的各将行动、死伤数字与战场位置待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000956",
      "reason": "李景隆赴济南日与燕军进入德州日不是同一动作，后续回查各卷。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000958",
      "reason": "既有卷四说八月复德州，卷五概括在九月，按出处保存每项年月和语境。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000959",
      "reason": "沧州战的干支有戊午、庚申两种，保留卷四卷五引文；降卒数为本纪所载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000961",
      "reason": "东昌战伤亡数字、张玉身份和援军具体抵达时间另核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000963",
      "reason": "威县、深州是不同地点。卷四深州条有乙丑，卷五合叙于辛酉条。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000965",
      "reason": "夹河叙事有两卷视角差异，人物和战场细节待进一步校核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000966",
      "reason": "薛嵓的稳定人物键与议和、战事的先后待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000967",
      "reason": "武胜、李远的稳定人物键和五月与六月事件界限待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000968",
      "reason": "刘江迎战及房昭军调动细节需要与卷四核对，进攻和战败的日序分开。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000969",
      "reason": "校记指出此峨眉山又名齐眉山，属易州，和建文四年四月灵璧齐眉山分开。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000970",
      "reason": "三府范围及朱棣所说京师空虚是本纪叙事与引语，具体时点、涉事中官另查。"
    }
  ]
}
