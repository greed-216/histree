  "coverage": "卷285原55—60行连续六段，发布后946年累计30/56，余26段。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v285-y0946-p025",
      "note": "献物是任命前追述，具体献物时间未定；甲辰授职据通鉴和旧五代史。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p026",
      "note": "黄河临黄决口据九月丙辰；灾情未补数量。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p027",
      "note": "瀛州来信是诱敌，兵力、内应和水阻均注明书信声称；旧五代史正文补明假降，地图只录献图事实。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p028",
      "note": "赠财交好与朝中褒扬为追述，年份未定；建议与十月辛未正式部署分开，九将逐项校核旧本纪；敕榜目标和奖赏未当执行结果。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p029",
      "note": "陈诲946被杀与新五代史后续陈诲活动疑问保留待核，不定人物死年；董思安父仅名章不新建无全名人。吴越派兵日壬午，三万为总数，不提前录后续胜仗。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p030",
      "note": "募兵相对明日不挂派兵次日。军谋与馈运职责分开，元危父子异姓不猜收养，弘亿明确为弟。八害是劝谏理由非客观结论；北征与宿卫空虚按明载，不补人数。"
    }
  ],
  "source_contexts": [
    {
      "source_key": "tongjian-285-946-august-october",
      "note": "只续录25—28段，不重录19—24。"
    },
    {
      "source_key": "tongjian-285-946-october-november",
      "note": "只录29—30段，十一月行营、瀛州追战、中度桥等在后批继续。"
    },
    {
      "source_key": "xinwudaishi-067-fuzhou-relief",
      "note": "只补救福州出兵三万；后续败南唐及俘将尚不提前。"
    }
  ],
