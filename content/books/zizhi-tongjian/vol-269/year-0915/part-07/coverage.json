  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v269-y0915-p022",
      "note": "主书仅称永顺节度使“存”；马存与马賨是不同的楚王弟，911年马賨受永顺节度使官，此时是否转由马存须纸本及官历核。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p022",
      "note": "新五代史后记马氏为楚王女、刘岩皇后，只用于婚姻对象身份补充，不提前写为915年已册后。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p023",
      "note": "蜀两路攻秦州和凤州为任命及军事目标；攻城结果未在此段明言。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p024",
      "note": "徐温、徐知训在新五代史作繁体“徐溫”“徐知訓”，既有人物别名已修订并匿名读回，见content/revisions/2026-10-02-xu-wen-zhixun-traditional。"
    }
  ]
}
