    ],
    "book": "资治通鉴",
    "volume": 285,
    "year": 945,
    "batch_key": "zztj-v285-y0945-p001-p010",
    "review": "曹州升节镇与军额，同主旧戊申。"
  },
  {
    "id": "zztj-v285-y0945-p010",
    "source_line": 15,
    "text": "遣侍卫马步都指挥使李守贞戍澶州。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_285_0945_li_shouzhen_garrisons_chanzhou"
    ],
    "book": "资治通鉴",
    "volume": 285,
    "year": 945,
    "batch_key": "zztj-v285-y0945-p001-p010",
    "review": "戍澶非授澶节度，主书独立段无日，不强套戊申；旧纪保原对应位置。"
  },
  {
    "id": "zztj-v285-y0945-p011",
    "source_line": 16,
    "text": "乙卯，遣彰德节度使张彦泽戍恒州。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_285_0945_zhang_garrisons_hengzhou"
    ],
    "book": "资治通鉴",
    "volume": 285,
    "year": 945,
    "batch_key": "zztj-v285-y0945-p011-p018",
    "review": "彰德相州对应同职，戍恒非授恒节度。"
  },
  {
    "id": "zztj-v285-y0945-p012",
    "source_line": 17,
    "text": "汉主杀刘思潮、林少强、林少良、何昌延。以左仆射王翻尝与高祖谋立弘昌，出为英州刺史，未至，赐死。内外皆惧不自保。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_285_0945_han_kills_liu_sichao",
      "event_zztj_285_0945_han_kills_lin_shaoqiang",
      "event_zztj_285_0945_han_kills_lin_shaoliang",
      "event_zztj_285_0945_han_kills_he_changyan",
      "event_zztj_285_0945_han_sends_wang_fan_yingzhou",
      "event_zztj_285_0945_han_kills_wang_fan_before_arrival",
      "event_zztj_285_0945_han_court_fears_purge"
    ],
    "book": "资治通鉴",
    "volume": 285,
    "year": 945,
    "batch_key": "zztj-v285-y0945-p011-p018",
    "review": "汉主复用刘弘熙更名晟；何昌延廷同组对应异文待核。主四名新五人不补第五者。左仆射新右仆射并列；高祖此句刘岩。王调英未到即死，旧谋议非本年新谋。"
  },
  {
    "id": "zztj-v285-y0945-p013",
    "source_line": 18,
    "text": "冬，十月，癸巳，置镇安军于陈州。",
    "status": "published_verified",
