  "coverage": "连续第22—29段，原107—114行；九月至十一月及八月追述。全年38段，累计29段，剩余9段待录。",
  "source_issues_review": "李敏闽国宰相与唐昭宗旧名及早期闽尚书身份需分别处理；花山与湖阳、空名宣敕十与十数、逃走单骑与数十骑等异说保留。旧史十二月记奏十一月战事，奏报月与战日严格区分。纸本及异文待核。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v282-y0941-p022",
      "note": "九月辛酉为滑州奏报日，河决发生日期未载。"
    },
    {
      "paragraph_id": "zztj-v282-y0941-p023",
      "note": "九月乙亥为遣杨彦询日，抵帐及应答未明日期；恶子是外交比喻，不建立血缘关系。"
    },
    {
      "paragraph_id": "zztj-v282-y0941-p024",
      "note": "王亚澄升威武节度使兼中书令与改封长乐王分于此前任官，父子关系不重复。"
    },
    {
      "paragraph_id": "zztj-v282-y0941-p025",
      "note": "郭威奉诏劝白承福、厚礼建议、威胁性劝说与十月实际归附、安置、表荐及收编分开。表领节度使不当明确已授；安重荣此前檄文云各部共同起兵保留声称，各部后来未赴援不自动推已结盟或背叛。"
    },
    {
      "paragraph_id": "zztj-v282-y0941-p026",
      "note": "王延羲即皇帝、王延政自称元帅与李敏去世分录。李敏为闽宰相，与唐昭宗旧名消歧；是否与早期闽尚书及李春燕父亲同人另待核。"
    },
    {
      "paragraph_id": "zztj-v282-y0941-p027",
      "note": "八月北行预备宣敕追述不套十一月；十数通与旧史十通差异保留，接受建议与实际动用敕令分期。"
    },
    {
      "paragraph_id": "zztj-v282-y0941-p028",
      "note": "十一月攻邓、武延翰奏报、石重贵遣军会合及丁丑统帅先锋任官分录；郭金海族属、陈思让及宋彦筠籍贯直接引用。"
    },
    {
      "paragraph_id": "zztj-v282-y0941-p029",
      "note": "十一月庚辰临时留守与十二月正式调任有别；邓州守御败退、癸未花山遇敌、俘安弘义及襄州自守分开。主书花山与新史湖阳、将领及火攻不同，旧史战日奏报十一月二十七和一万余人的兵数、单骑与数十骑分别保留，未提前记自焚。"
    }
  ],
  "plain_language_review": "首次检查新增人物介绍、事件说明、参与角色、关系方向、时间及事实引用；外交比喻、檄文声称、授官承诺、实际归附、上表、奏报与战斗日期分别说明，原文保留，旧主体字段不扩大改写。"
