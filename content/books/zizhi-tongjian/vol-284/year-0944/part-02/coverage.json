  "source_contexts": [
    {
      "source_key": "xinwudaishi-068-zhu-wenjin",
      "note": "仅引用朱文进掌权和早期任官，后续漳泉反朱、许降殷及朱连之死留待后续主线，不提前。"
    },
    {
      "source_key": "xinwudaishi-065-hongchang-death",
      "note": "仅补弘昌遇害，后续弘泽被毒杀随十月段落另录。"
    },
    {
      "source_key": "jiuwudaishi-082-944-april",
      "note": "只补德州失守的四月奏报，四月其他政务未提前。"
    },
    {
      "source_key": "jiuwudaishi-082-944-march",
      "note": "复用三月快照，只补赵守贝、泰州战及乡兵诏，不提前处理太常丞王绪等补传疑点。"
    }
  ],
  "coverage": "卷284原14—21行连续第9—16段，三月及追述；下接第17段四月德州恢复，944全年尚未完成。",
  "source_issues_review": "弘昌乾和二年夏纪时、赵贝州守任甲申壬午、闽主探病醉归场景及景宗谥庙形式保留；程文纬程贇待核，许稹縝异文保留，后降殷不提前。联姻支系未知不造配偶。纸本待核。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v284-y0944-p009",
      "note": "受命祭陵、至宫和被刺杀分开，不造已经祭成。新史乾和二年夏纪时独立引用；洪昌弘昌与晟弘熙沿用主体，不强将主书三月排列认作真实死月。"
    },
    {
      "paragraph_id": "zztj-v284-y0944-p010",
      "note": "实际两路北归和焚掠、赵贝州留后及俘户内迁、麻答陷德擒尹分开。旧纪甲申与辽史壬午异日并列；旧史四月滄奏是报告条，与主三月北归情境分清。尹未写死。"
    },
    {
      "paragraph_id": "zztj-v284-y0944-p011",
      "note": "朱连联姻为家族姻亲不是夫妻。杀魏诵诗与后计划均追述未知年。李后欲立亚澄非已即位，实际朱上位。探病行刺与新史醉归异说；福州宗族五十余被杀不扩大到全部王族。葬谥庙号、连六军、郑拒黜将奔而被杀、宫女营造诏令、吴讨不克和三任官及许投朱逐项录。程文纬程贇待核不强合；许稹縝按同州同政局姓名异文保留，后降殷不提前。"
    },
    {
      "paragraph_id": "zztj-v284-y0944-p012",
      "note": "三镇返军诏不强作执行完毕。"
    },
    {
      "paragraph_id": "zztj-v284-y0944-p013",
      "note": "泰州攻拔与俘二千有旧纪补，不伪精确牲畜兵器数量。"
    },
    {
      "paragraph_id": "zztj-v284-y0944-p014",
      "note": "七户出一人六户资之与自具兵仗旧纪癸巳军号独立补，主书后来军号诏未提前认已录。"
    },
    {
      "paragraph_id": "zztj-v284-y0944-p015",
      "note": "秦兵救阶经黄阶岭战西平，未具名将领不造主体或收复全州。"
    },
    {
      "paragraph_id": "zztj-v284-y0944-p016",
      "note": "汉主刘弘熙，陈偓本字不猜同其他陈姓人物，任官明确无日期。"
    }
  ],
  "plain_language_review": "首次逐项检查标题、正文、人物、参与角色、关系与事实说明，主语明确。联姻、计划即位、实际掌权、命令执行、奏报月份及追述分别处理，原文保持。"
}
