  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v286-y0947-p069",
      "note": "李氏复用刘知远妻，癸亥册立与前批劝谏身份分开。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p070",
      "note": "责赵延寿、张砺是耶律德光言论，不确认史实唯一因果。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p071",
      "note": "两位宰相分别授职，籍贯不作为任命地点；旧史大学士补证独立保留。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p072",
      "note": "折更名沿已有key；北方府州与福州不同；刘铢授河阳节度不证明已经入城。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p073",
      "note": "耿屯兵拟攻与乙丑救援诏令分清，万人是出援规模，未补攻取结果。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p074",
      "note": "郑廉与郑谦、原文谦万进经同职同事识别；军号与朔州、振武等写法分别保留；经略及分兵是意图。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p075",
      "note": "北运计划、河阴劝议、分兵器杀监军、崔送耿、占城、遣弟分录。主书乘虚与旧史宋史交战并列；人数不加家属；派弟不等于到达。"
    }
  ],
  "source_issues_review": "郑廉谦同事异写；地方军号与武行德军职差异并列；占河阳乘虚与交战说保留，宋史非单独确证；全书范围未完成。",
