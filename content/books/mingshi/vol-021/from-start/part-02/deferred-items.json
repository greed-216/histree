  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003302",
      "reason": "房嘉宠、张良贤的规范人物键待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003304",
      "reason": "晚期本纪“土蛮”是否为部名泛称待核，避免将此条强配给早年同名首领。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003307",
      "reason": "陈奉受伤记录有年、月异说，保留校记；后一段武昌民变及召回分录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003308",
      "reason": "贡使抵达日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003314",
      "reason": "解生、炒花稳定人物键和战事具体日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003315",
      "reason": "税监杨荣与早年宰辅杨荣同名，后者排除。宝井地名待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003317",
      "reason": "利玛窦进献具体日与各地灾害、奏罢矿税人员仍待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003319",
      "reason": "皮林战事各阶段及奉诏实施日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003321",
      "reason": "张以诚及同科名录、武昌民变确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003323",
      "reason": "五月与六月壬申异文保留，孙隆规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003324",
      "reason": "畿内赈济的确日与范围待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003325",
      "reason": "沈鲤和朱赓获任与到任分录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003328",
      "reason": "贡使抵达日期待考。"
    }
  ]
}
