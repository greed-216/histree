    },
    {
      "id": "mingshi-2f603db3d81e-p001717",
      "book_key": "mingshi",
      "book": "明史",
      "source_version": "2f603db3d81e",
      "section_id": "mingshi-2f603db3d81e-s0013",
      "section_title": "卷十二",
      "section_kind": "volume",
      "volume_candidate": 12,
      "volume_part": "",
      "volume_verified": false,
      "structural_volume_verified": true,
      "kind": "body",
      "text": "夏四月甲午朔，以災異數見求直言。乙未，免浙江被災稅糧。丁酉，方瑛攻銅鼓藕洞苗，悉平之。丁未，錄囚。癸丑，罷團營。乙卯，孛來寇寧夏，參將种興戰死。",
      "boundary_basis": "epub_source_paragraph",
      "review_status": "pending",
      "flags": [],
      "locator": {
