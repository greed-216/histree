    {
      "paragraph_id": "mingshi-2f603db3d81e-p001988",
      "reason": "正文作正月起复，卷末校记有实录和年表二证，按正月奔丧、七月起复处理。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001989",
      "reason": "底本三月朔日作已巳，历表该月首日干支为己巳，原字保留在引文。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001990",
      "reason": "卷174王玺传把相关用兵系于前一年开端，独立的夺城过程待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001994",
      "reason": "闰月为闰八月；应时用的规范键及赎复官职确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001997",
      "reason": "各次贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002002",
      "reason": "陈政的规范人物键及战事地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002003",
      "reason": "小王子为本纪称谓。卷174周玉传也作小王子，同卷陈璽传同年另以亦思马因记大同战事，所指及具体战斗关系待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002004",
      "reason": "李衍的规范键、朱永各次战斗次序待核。对汪直的贬职据本条，与六月调南京分录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002006",
      "reason": "进献狮子的实际到达日期待核。"
    }
  ]
}
