      "source_sha256": "d3cf97a7793a524ed006dce4170fc30740f5ff7ed21a9d5057cc5d57f178a201",
      "quotation": "命知诰为子景通娶其女以解之。",
      "quotation_verified": true
    },
    {
      "person_id": "70906153-ef05-55ab-b89f-58cf163dfda3",
      "name": "徐玠",
      "claim_id": "6a77158f-e3e1-5bd3-bd60-b91988233235",
      "citation": "卷268·乾化二年（912）·zztj-v268-y0912-p011·原文件第51行",
      "source_url": "https://github.com/greed-216/histree/blob/425c28ca/content/books/zizhi-tongjian/vol-268/year-0912/part-01/sources/library/tongjian-268-912-next/source.txt",
      "source_sha256": "dd100cc4559106cd245694d32fbb02050322720826415baee91b0546190c4365",
      "quotation": "馆驿使徐玠使于吴越，道过宣州，温使玠说遇入见新王，遇初许之；玠曰：“公不尔，人谓公反。”遇怒曰：“君言遇反，杀侍中者非反邪！”",
      "quotation_verified": true
    },
    {
      "person_id": "755daf3d-2f6b-5807-87ec-930fea729b93",
      "name": "荝剌",
      "claim_id": "95c9a9a7-c9f0-5eb6-8594-5596126fdd5d",
      "citation": "卷277·长兴三年（932）·zztj-v277-y0932-p012·原文件第126行",
      "source_url": "https://github.com/greed-216/histree/blob/585a188b/content/books/zizhi-tongjian/vol-277/year-0932/part-01/sources/library/tongjian-277-932-february/source.txt",
      "source_sha256": "2ad7b978ef48a501575d6c117b4b5c20d9bcdb852a5c31956a3825468806060a",
      "quotation": "初，契丹舍利荝剌与惕隐皆为赵德钧所擒，契丹屡遣使请之。",
      "quotation_verified": true
    },
    {
      "person_id": "8d6b60ab-f30f-5e4d-b55d-60225289b374",
      "name": "马胤孙",
      "claim_id": "b17e5654-5b72-5663-98db-630e132e3eed",
      "citation": "卷279·清泰元年（934；二、三月闵帝应顺元年）·zztj-v279-y0934-p005·原文件第10行",
      "source_url": "https://github.com/greed-216/histree/blob/570df7a6/content/books/zizhi-tongjian/vol-279/year-0934/part-01/sources/library/tongjian-279-934-february/source.txt",
      "source_sha256": "6a2b6e2f9de3452ba02c6a82f73144333955d6b4838714e18ac95415bda3d01d",
      "quotation": "王问观察判官滴河马胤孙曰：“今道过京师，当何向为便？”对曰：“君命召，不俟驾。临丧赴镇，又何疑焉！诸人凶谋，不可从也。”众哂之。",
      "quotation_verified": true
    },
    {
