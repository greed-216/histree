  "claims": [
    {
      "key": "claim_zztj_260_0895_01_0001",
      "subject_table": "event",
      "subject_key": "event_zztj_260_0895_keyong_welcomed_youzhou",
      "field_path": "description",
      "claim_text": "幽州军民数万以麾盖、歌鼓迎李克用进入府舍。",
      "source_key": "tongjian-260-895",
      "citation": "卷260·乾宁二年（895）·zztj-v260-y0895-p001·原文件第6行",
      "note": "原文：春，正月，辛酉，幽州军民数万以麾盖歌鼓迎李克用入府舍；克用命李存审、刘仁恭将兵略定巡属。；核对说明：承894年末进幽州受降，迎入府舍是本年后续，不重建894年攻城；数万为书载概数。",
      "status": "draft"
    },
