  "pending_paragraphs": [
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000941",
      "observations": [
        "朱棣系太祖第四子见本纪；母亲依卷首原称“母孝慈高皇后”保留于出处，待与其他记载的身份说法对读。迤都的降者与军事数量另核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000943",
      "observations": [
        "按卷四、年表与卷三沿用同一事件。削藩过程涉及数位藩王的不同年份，本段概述不作同日，不把立场评语当事实。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000945",
      "observations": [
        "倪谅、于谅、周铎等人员规范键和处置细节待考；道衍和张玉、朱能身份另查。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000946",
      "observations": [
        "继续区分燕方援引祖训的理由、本纪所报各地占领经过。起兵、夺九门、攻各城都有各自时间。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000947",
      "observations": [
        "卷四七月系任将，本纪八月追叙。潘忠、杨松被俘及鄚州陷落的日序在卷四、卷五写法有别，另立校核项后再定合并方式。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000948",
      "observations": [
        "兵数系本纪所称；援永平与吴高退走的两道日序据卷五分录，和卷四同月叙述的对应点待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000949",
      "observations": [
        "壬寅系十月据校记[1]。各军将和大宁、会州、松亭关的地望另核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000950",
      "observations": [
        "冰合、复解为本纪所叙，确切地理限于书中用名；陈晖、白河与所属军队另考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000951",
      "observations": [
        "广昌历史地点、李景隆调兵及次年实际出兵的时间待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000953",
      "observations": [
        "卷五系蔚州陷于正月，卷四二月条合记，保留两卷月份。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000954",
      "observations": [
        "暂保留朱棣、李景隆进退和冻馁人数的卷五叙述，具体日期与人员范围待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000955",
      "observations": [
        "白沟河按两天分录。不同叙事中的各将行动、死伤数字与战场位置待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000956",
      "observations": [
        "李景隆赴济南日与燕军进入德州日不是同一动作，后续回查各卷。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000958",
      "observations": [
        "既有卷四说八月复德州，卷五概括在九月，按出处保存每项年月和语境。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000959",
      "observations": [
        "沧州战的干支有戊午、庚申两种，保留卷四卷五引文；降卒数为本纪所载。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000961",
      "observations": [
        "东昌战伤亡数字、张玉身份和援军具体抵达时间另核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000963",
      "observations": [
        "威县、深州是不同地点。卷四深州条有乙丑，卷五合叙于辛酉条。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000965",
      "observations": [
        "夹河叙事有两卷视角差异，人物和战场细节待进一步校核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000966",
      "observations": [
        "薛嵓的稳定人物键与议和、战事的先后待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000967",
      "observations": [
        "武胜、李远的稳定人物键和五月与六月事件界限待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000968",
      "observations": [
        "刘江迎战及房昭军调动细节需要与卷四核对，进攻和战败的日序分开。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000969",
      "observations": [
        "校记指出此峨眉山又名齐眉山，属易州，和建文四年四月灵璧齐眉山分开。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p000970",
      "observations": [
        "三府范围及朱棣所说京师空虚是本纪叙事与引语，具体时点、涉事中官另查。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000973",
      "observations": [
        "淝河战事复用卷四，四万是卷五所载人数；谭清的稳定人物键和大店地望待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000974",
      "observations": [
        "小河、齐眉山、灵璧依不同阶段记载；灵璧两卷的干支有差异，三十七人列为本纪所载。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000975",
      "observations": [
        "两卷分别系淮河战事与割地议和，此处保留各自的日序与行动细节。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000976",
      "observations": [
        "两卷保留建文帝下落的不同叙述；各官员身份和退爵、定谥的后续材料尚待补考。齐泰沿用年表编号。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p000977",
      "observations": [
        "依据本段改用洪武三十五年，保留建文四年同年异称。吴、衡、徐王规范主键及同人异字另查。"
