  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001289",
      "reason": "亲属以卷九明文为据。梦兆保留在原文；军中讲授经史的具体时日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001291",
      "reason": "立皇太子的准确时间沿用卷八永乐二十二年十月，召太子还另有洪熙元年五月庚辰。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001292",
      "reason": "入宫发丧的地点与具体环节待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001293",
      "reason": "大藤峡战事细节及各次前往时间待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001294",
      "reason": "卷末校记辨明吴成异文，薛贵、马英、梁成身份及巡边地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001295",
      "reason": "安定、曲先地点与安定王来朝的确日待核；巡抚设置为本纪概括，与前朝临时派遣区分。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001298",
      "reason": "薛禄规范人物键与巡防范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001300",
      "reason": "各来使身份、译写和到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001302",
      "reason": "黄宗载等官员的规范人物键及清理军伍法令的另行定颁日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001304",
      "reason": "茶笼州战事与永乐二十二年另一处同地战事分开，琴彭、方政的规范人物键和地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001305",
      "reason": "王通得任和陈智、方政的后续军事分工待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001306",
      "reason": "赦免的具体执行范围、薛禄规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001308",
      "reason": "郑、襄两王和薛禄规范人物键及招降文书详文待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001309",
      "reason": "只据本纪记录供词牵涉晋王和赵王，二王的规范人物键与审讯详情待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001311",
      "reason": "应平地望及陈洽战死经过待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001312",
      "reason": "谭忠爵位与写法见卷末校记，主要将领以清楚身份先录，其余稳定人物键及分兵细目待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001313",
      "reason": "白葛达等地名异写及各贡使到达日期待核。"
    }
  ]
}
