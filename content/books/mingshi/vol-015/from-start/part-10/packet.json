      "volume_candidate": 15,
      "volume_part": "",
      "volume_verified": false,
      "structural_volume_verified": true,
      "kind": "annotation",
      "text": "↑ 九月壬午普安賊婦米魯作亂孝宗實錄卷一五一、國榷卷四四頁二七三七均繫於六月癸卯。此「九月壬午」係兵部議奏征討之日，非始事之日，參見孝宗實錄卷一五四。",
      "boundary_basis": "epub_source_paragraph",
      "review_status": "pending",
      "flags": [],
