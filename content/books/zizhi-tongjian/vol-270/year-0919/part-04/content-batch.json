  "claims": [
    {
      "key": "claim_zztj_270_0919_04_0001",
      "subject_table": "event",
      "subject_key": "event_zztj_270_0919_qian_chuanguan_attacks_changzhou",
      "field_path": "description",
      "claim_text": "钱镠遣钱传瓘率军攻吴常州，徐温分兵抵御。",
      "source_key": "tongjian-270-919-lanshan",
      "citation": "卷270·贞明五年（919）·zztj-v270-y0919-p013·原文件第86行",
      "note": "原文：秋，七月，吴越王镠遣钱传瓘将兵三万攻吴常州，徐温帅诸将拒之，右雄武统军陈璋以水军下海门出其后。；核对说明：三万为原书军数；陈璋水军出敌后作为同段吴军部署，不推测具体行军日次。",
