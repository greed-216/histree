      "source_sha256": "1a6807f0fc0ff77d0991a7f8321877b9f0d9143c03707508a989b3e9cc6b915e",
      "verbatim_excerpt": "守荣抽佩刀欲刺之，敬瑭亲将陈晖救之，守荣与晖斗死，"
    },
    {
      "claim_id": "223b85a5-2db7-5dd5-9bc2-8da151beecef",
      "source_url": "https://github.com/greed-216/histree/blob/17a0b9a305d40d6371bbdd66d1827c8f2f7321fa/resources/derived/tongjian/266.txt",
