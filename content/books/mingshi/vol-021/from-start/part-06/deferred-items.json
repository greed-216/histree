  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003414",
      "reason": "红崖、青湖具体位置和参加交战者待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003416",
      "reason": "徐疏实际所指人员、各处洪水确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003418",
      "reason": "停办热审确日及覆盖范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003419",
      "reason": "本段赵世卿离职与上年七卿年表请假候命分开，阁臣请求的确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003420",
      "reason": "贡使抵达日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003422",
      "reason": "年表称致仕，本纪称拜疏自去，保留各书措辞。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003424",
      "reason": "二十余年等说法为御史奏疏原文，完整联名人员待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003426",
      "reason": "决口确日与河段待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003427",
      "reason": "自去与朝廷批准退职次序待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003429",
      "reason": "回国与遣使所历各日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003432",
      "reason": "同科名录待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003434",
      "reason": "与河套同名部首领是否有联系待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003436",
      "reason": "吴道南的任命与入阁到任日待考；赵焕自去保留本纪措辞。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003437",
      "reason": "各处洪水分时、贡使抵达待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003442",
      "reason": "以遗命施赦与安葬各从原历所载。"
    }
  ]
}
