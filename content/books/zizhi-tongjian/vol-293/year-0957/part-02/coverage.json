  "excluded_non_body": [],
  "coverage": "原71—78行连续八段，后续未计。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v293-y0957-p007",
      "note": "二月乙酉到下蔡，三月己丑夜渡淮、庚寅战与暮返分开；旧数寨数千与主两寨三千余各保口径，宋全战合叙不抢定受降日。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p008",
      "note": "指控与撤换、准备夺兵、欲自杀和劝说、投降与拒降被杀分阶段。旧是夜承庚寅与主辛卯夜不同。杨守忠与891人无同人桥证，分别保存。孙璘补名关联同事件，门客方向明确。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p009",
      "note": "预判与实际东逃分开，死亡溺死投降近四万为合计，物资十万不当船数。癸酉日序疑原保不校。主甲午与新二月合叙各保，桥攻击未成功，不写桥焚毁。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p010",
      "note": "全军还指陈德诚所部，不扩大为全南唐。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p011",
      "note": "武宁军与旧徐州称法对应，向训新职和戍守任务一体，不造重复调任。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p012",
      "note": "己亥回下蔡、庚子劝降诏分开，未当守将已答应。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p013",
      "note": "亲督是议案，乔谏流放与两将不同处分分明。罗隐是被引用诗人非在场，李最终未出。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p014",
      "note": "甲辰耀兵、丙午病重代拟、丁未宣谕和子谢、戊申抬出受降回养依序。旧派使丙午与主丁未、张保续保绩异文并列，崇让崇谏区分父亲边明确。"
    }
  ],
  "source_issues_review": "癸酉日序疑保原字。朱元降日、筑城移桥及入城使者纪时各保异说；张保续保绩同任务姓名异文纸本待核。杨守忠分别建档，伤亡俘获船粮口径不相加。",
  "plain_language_review": "首次逐条检查主体、标题正文、参与和关系方向及事实解释。指控评价与事实、计划与执行、病重代拟与表署名分开；原文疑日疑字不静默校正，死亡状态不抢录。"
}
