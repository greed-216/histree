  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001529",
      "reason": "徐亨、马亮及四名监军稳定人物键与分路范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001530",
      "reason": "本纪明确战果，俘获家属与朝廷接收的各自日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001531",
      "reason": "太学地点、马亮稳定人物键及杨士奇具体卒日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001533",
      "reason": "马昂规范人物键及京师与南京复核范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001535",
      "reason": "石璟、竺渊规范人物键、福安矿案参与人及凶手细节待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001536",
      "reason": "银场恢复的具体地点和长廊设施损毁范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001537",
      "reason": "陕西救济明细和也先所部边境情况另考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001540",
      "reason": "各地洪水发生具体月日、贡使日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001543",
      "reason": "兀良哈贡使身份与京师地震损失范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001544",
      "reason": "思机发派使还是亲往须另查列传，保留入贡措辞。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001547",
      "reason": "仓粮调运售卖地点和总量待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001549",
      "reason": "高谷底本作高穀，保留原文。具体侍郎左右衔按年表独立保存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001550",
      "reason": "《缅甸传》正统八年已有擒获奏报，十二年载献至京。正文十年丙辰合记的各阶段待核；赈粮干支见卷末校记，柳溥稳定人物键待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001551",
      "reason": "各次来使和到达日期待核。"
    }
  ]
}
