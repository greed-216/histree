  "coverage": "原41—48行连续八段，从二月任相至五月秦凤出军；原快照所含未来战役段落未计覆盖。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v292-y0955-p009",
      "note": "唐主为南唐李璟，严续任相日未载，不套求言诏壬戌。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p010",
      "note": "三月新增静安军军额与正月筑城部署分开，补书同日印证。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p011",
      "note": "高平后统一志向为回述，秦州来者姓名未载；采纳建议不等已经攻取秦凤。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p012",
      "note": "赵季札巡视、批评、自请与丙申受任分开。他批评两将能力不是本站定论，给兵不当已经到任。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p013",
      "note": "扩城命令、标志、分期施工、葬埋界限与规划后民居安排分开。今冬与旧来春开工差异保存，未录已竣工。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p014",
      "note": "孟昶遣王昭远检查北边，主体与柴荣区分。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p015",
      "note": "完整长篇策略按主张附同次献策引用，不造已攻下地区。官号与人数、开边和平边题名差别并列；人才财用、袭扰动员、次序与河东后图均已处理。"
    },
    {
      "paragraph_id": "zztj-v292-y0955-p016",
      "note": "王溥推荐与三将奉命、五月实际出兵分开。王景通过宋传相州耀州至凤翔连续履历复用；昝居润传电子题名误识已说明。未来秦凤平后任职未录。"
    }
  ],
  "source_issues_review": "扩城今冬与旧来春差别保留，开边策与平边策题名异文保留；寝令及恩隐疑字不改原文。宋262总题名误识李濤傳，昝居润由明确姓名和同节上下文识别。王景同名通过连续履历回查，纸本待核。",
  "plain_language_review": "首次逐条检查所有标题、人物介绍、角色、关系、时间、策论事实与校核说明。策略与预期不当已执行战果，诏令与竣工、受命与实际出兵分开，引用保持原字。"
}
