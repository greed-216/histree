  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002463",
      "reason": "兴献王薨与朱厚熜以世子理事分录；本纪和卷104均只载薨于正德十四年，具体月日待核。尊号校字另见卷末。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002465",
      "reason": "韦彬据校记和卷191规范为韦霦，卷192明列韦霦、魏彬为两人。张锦的稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002466",
      "reason": "按同段次序分录京郊礼仪争议、即位、改元、奉迎和费宏奉召，各保留原有日期精度。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002468",
      "reason": "此处据校记补六月；江彬伏诛与卷十六下狱分列。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002469",
      "reason": "礼臣早先引宋代濮议的各次奏报、刘爵稳定人物键和小王子所指待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002472",
      "reason": "乾清宫完工后所叙两条诏令保留当月精度，另次赈灾与六月赈灾时日可分。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002474",
      "reason": "火灾与称号决定的独立具体日待核。军乱与卷192、204同一许铭案。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002483",
      "reason": "贡使到达日期待核。"
    }
  ]
}
