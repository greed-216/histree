    ],
    "book": "资治通鉴",
    "volume": 281,
    "year": 938,
    "batch_key": "zztj-v281-y0938-p017-p020",
    "review": "初提示幽州留守、祁州刺史及归附请求追叙，年月留空。赵思温复用，赵延照新建父子方向明确；辽史证留守及父子身份，其他生涯未另作本年事件。"
  },
  {
    "id": "zztj-v281-y0938-p019",
    "source_line": 85,
    "text": "契丹遣使诣唐，宋齐丘劝唐主厚贿之，俟至淮北，潜遣人杀之，欲以间晋。",
    "status": "published_verified",
