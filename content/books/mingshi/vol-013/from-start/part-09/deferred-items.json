{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001917",
      "reason": "同科人员名次待补。彭时卒日辛未与赐进士壬子分开。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001920",
      "reason": "通惠河施工范围及使团名录待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001923",
      "reason": "成化十一年十二月对应公元1476年。景帝帝号恢复以本纪日次录入，卷十一末尾另有恢复谥礼的追记。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001924",
      "reason": "各次贡使到达时间与琉球贡期诏书确日待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001927",
      "reason": "紫城砦、紫垣砦、紫金砦地望待进一步校核。"
    }
  ]
}
