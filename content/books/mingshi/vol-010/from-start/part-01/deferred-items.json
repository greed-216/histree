{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001427",
      "reason": "本纪称母孙氏，《后妃传》另载孙氏将宫人之子作为己子。两源说法保留，生母与具体出生日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001429",
      "reason": "即位和蹇义去世分别按各自干支；大事禀皇太后及停午朝的细目待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001430",
      "reason": "两次尊位和封郕王分别计日，礼制实施及仪节待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001432",
      "reason": "元儒吴澄沿用已有稳定编号。其他出捕人员身份及调查结果待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001433",
      "reason": "二百七十七万余石为本纪记载的奏报数，分地统计仍待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001437",
      "reason": "督漕及巡抚议事的具体议程与王振掌监确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001440",
      "reason": "《鞑靼传》明确阿台与朵儿只伯分别两人，黑山地望及两部战果细目待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001441",
      "reason": "各次来使、贡物和到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001444",
      "reason": "周旋等规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001447",
      "reason": "蒋贵、赵安的稳定人物键及随后出兵线路待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001448",
      "reason": "何文渊规范人物键已核，王佐与朱与言的稳定编号及三地具体分工待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001450",
      "reason": "获释未单标确日，萧授稳定人物键、蒙顾十六洞具体地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001451",
      "reason": "十一国遣还各自日期及人员待考。"
    }
  ]
}
