  "coverage": "卷285原39—46行连续八段，946年共56段，本批发布后累计16段，仍40段待录。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v285-y0946-p009",
      "note": "初字市马与调邠陕入卫为追述；静难保义对应军镇州名不造重复迁转。丙寅才复任，率关西任务非已胜。厚事不猜金额。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p010",
      "note": "乙丑为定州奏报，诸任命未独立给日，旧六月段保留，不套壬午。十营不乘二。李彦韬后晋主体与温韬不混；监知与内恨不造笼统敌对关系。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p011",
      "note": "初字外交为建州后追述，欲取未准非已战；陈自请和宋推荐是预期，母妻未名四弟官名不造。主陈不敢言与新召而不从细节不同并列；矫诏兵事留后段。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p012",
      "note": "杨刘西岸决口与莘县朝城水道分开地名，四十里史载水宽，不换面积或坐标。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p013",
      "note": "消息和回书非真实归附。旧三月发信七月归书补时序；洛洺州职地异说。赵行实复用早期同名军将，未添亲属；约日期与接应地计划未已会师。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p014",
      "note": "八月奏报非明确战斗日，丁卯撤回独立日；解里暂不同945谐里合，死年据本年奏报。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p015",
      "note": "宴赏战澶戍滑热遣返牧皆追述不强946，旧族犯事不等后诬反确罪。白可久早逃与云州诱福是计划，承福未逃。"
    },
    {
      "paragraph_id": "zztj-v285-y0946-p016",
      "note": "刘郭谋议杀夺计划、帝迁部众、郭诱入城、诬反、实际围杀、没财褒赏影响分别。五族共四百口不每族400，1900迁众非400死同额。旧晋纪八月癸酉奏报补白铁匮赫连海龙；旧汉纪五月与新八月并列，帝为刘非石。王义宗统余众独立五月原书，不造未名两族。"
    }
  ],
  "source_contexts": [
    {
      "source_key": "tongjian-285-946-february-june",
      "note": "只录第9—10段；前2—8段已发布不重复。"
    },
    {
      "source_key": "tongjian-285-946-july-august",
      "note": "只录第11—16段；末第17—18段慕容彦超与陈觉矫诏福州战事留下一批。"
    },
    {
      "source_key": "jiuwudaishi-084-946-zhao-correspondence",
      "note": "只补三月送信、七月返回与再约接应；九月瀛州诈降和其他官命未提前。"
    },
    {
      "source_key": "xinwudaishi-062-chen-jue-fuzhou",
      "note": "只补陈觉自请宣谕、召入朝不从的说法；矫诏兵事、围城失败、监军与后世被流不提前。"
    },
    {
      "source_key": "jiuwudaishi-099-bai-chengfu-death",
      "note": "只补五月诛杀纪月及王义宗统余众；九月战事与十二月后晋投降未提前。"
    }
  ],
  "source_issues_review": "白承福处置主八月条及新八月、旧汉纪五月、旧晋纪八月癸酉奏报分层保留。洛州洺州职地异说，陈觉不敢言与召而不从差异保留。解里谐里近译未强合。电子本纸本未核不当独立确证。",
  "plain_language_review": "首次逐项阅读所有展示字段与事实说明，简体白话，主语明确。建议、密奏理由、诬告、书信承诺、战报与实际处置分开，未知时间和未名角色不猜补；逐字原文保持底本。"
}
