{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002628",
      "reason": "按卷110、114和礼志继续校核陵寢及礼仪。两座陵所指人物和现存地理需各自回查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002629",
      "reason": "卷328将同阶段分兵往来和诸将各场交战另叙，保留卷十七四月的叙事定位。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002630",
      "reason": "四战各处具体时间待核。按本纪“是秋”保留季节。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002632",
      "reason": "“皇长子”是本纪原称，本段据跨卷世系对读为载壑，另有前已夭折的长子载基；颁赦与出生日期关系待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002634",
      "reason": "两宫皆沿用已有实体，具体徽号和礼仪拆分可核庙礼。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002635",
      "reason": "各次贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002640",
      "reason": "赵镗稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002641",
      "reason": "参将张国辅的稳定人物键、来军主将、交战日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002642",
      "reason": "从收押到瘐死各个阶段的明确日次待列传复核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002643",
      "reason": "贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002646",
      "reason": "茅瓒及同科名录待核。征安南奉命、暂停、重新出军分录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002648",
      "reason": "周冕稳定人物键、来军具体指称、唐胄关押始末待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002651",
      "reason": "睿宗入祔为接续叙事，保留当月先后；已将朱棣改成祖庙号系回卷七原有条目。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002653",
      "reason": "李时卒由本纪补乙卯；蒋氏埋葬另见嘉靖十八年闰七月条。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002654",
      "reason": "贡使到达日期待核。"
    }
  ]
}
