      "paragraph_id": "mingshi-2f603db3d81e-p001976",
      "observations": [
        "各次贡使到达日期待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001980",
      "observations": [
        "其余科举名录待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001981",
      "observations": [
        "五年审录的后续具体期次及首次审录确日待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001982",
      "observations": [
        "本纪记调兵御敌；七卿年表记王越同月出镇宁夏，留作同月不同内容的记录。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001986",
      "observations": [
        "各次贡使日期、进攻与敕谕各自日期待考；卷321安南传另有相关经过。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001988",
      "observations": [
        "正文作正月起复，卷末校记有实录和年表二证，按正月奔丧、七月起复处理。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001989",
      "observations": [
        "底本三月朔日作已巳，历表该月首日干支为己巳，原字保留在引文。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001990",
      "observations": [
        "卷174王玺传把相关用兵系于前一年开端，独立的夺城过程待考。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001994",
      "observations": [
        "闰月为闰八月；应时用的规范键及赎复官职确日待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001997",
      "observations": [
        "各次贡使到达日期待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p002002",
      "observations": [
        "陈政的规范人物键及战事地望待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p002003",
      "observations": [
        "小王子为本纪称谓。卷174周玉传也作小王子，同卷陈璽传同年另以亦思马因记大同战事，所指及具体战斗关系待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p002004",
      "observations": [
        "李衍的规范键、朱永各次战斗次序待核。对汪直的贬职据本条，与六月调南京分录。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p002006",
      "observations": [
        "进献狮子的实际到达日期待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p002008",
      "observations": [
        "本纪载地震、修省、政令和南郊祭祀。诏书的独立颁日待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p002009",
      "observations": [
        "同科进士及李旻、太监张善的稳定人物键待考。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p002013",
      "observations": [
        "重新进据河套所涉部众、陕晋灾区详情和纳米事例具体规则待考。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p002014",
      "observations": [
        "张黻稳定人物键待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p002016",
      "observations": [
        "各次贡使到达日期待核。"
      ]
    },
    {
