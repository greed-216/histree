  "pending_paragraphs": [
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001599",
      "observations": [
        "卷首谱系及首封按本纪范围校核。恭仁康定为后来的谥号，具体追尊沿卷末另录。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001601",
      "observations": [
        "陈懋奉诏回师、诸军实际入京及运输日期待核，商辂、彭时同月入阁分条复用旧记录。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001602",
      "observations": [
        "季铎所传具体内容与上皇收悉日期待核。处州余部后续仍有活动。张安、王清、陈友、杨信民稳定人物键待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001603",
      "observations": [
        "请朝鲜出兵仅据诏命，实际回应待考。王复、赵荣之名按本纪校记并核王复传。京城附近各场战斗、守将与俘行地望待进一步核对。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001604",
      "observations": [
        "耿九畴抚安对象范围和修关各处地点待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001605",
      "observations": [
        "孟鉴、柳溥稳定人物键和赴任日期待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p001606",
      "observations": [
        "年度回顾原文未载各贡使到达确日。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001609",
      "observations": [
        "沙窝、栲栳山地望及郭登封爵确日另考。本传叙捷报到朝后受封，未记干支。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001610",
      "observations": [
        "杨能稳定人物键、各部出发日期未载。喜宁的被捕另有《王振传》记载。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001611",
      "observations": [
        "本纪分别记录己酉、乙卯两次朔州告警。追叙录用后人的名单和范围待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001612",
      "observations": [
        "李昇、何贵、李茂、刘安、曹泰稳定人物键待查。曹泰与三国曹仁之子同名，本卷并未合并。辛巳、癸卯两次大同战事分录。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001613",
      "observations": [
        "黄萧养死因，正文作伏诛，《董兴传》述中流矢身亡，均保留。刘安、田礼稳定人物键及燕门各处行动待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001614",
      "observations": [
        "陈镒、王文获释确日待核。李实、罗绮出使官衔在列传与本纪表述有所不同，保留本纪名衔。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001615",
      "observations": [
        "所擒首领身份和到京日待核。明廷遣杨善、赵荣之命、两人到达和也先许上皇归分别记账。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001616",
      "observations": [
        "商辂受命迎接与实际迎接地点分别依原文，南宫入居和后来管理情形依下卷。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001620",
      "observations": [
        "景帝驳回胡濙两次请求的确日未载。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p001621",
      "observations": [
        "年末汇记三次进贡，其各自时间和数目待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001624",
      "observations": [
        "星变的具体天象及授田、贷种推行范围待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001625",
      "observations": [
        "其余进士姓名、授予名次待另查，柯潜名次待列传卷录。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001626",
      "observations": [
        "平越战事及送俘到京的各自日期待核。后两条与平越战事另按干支记录。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001628",
      "observations": [
        "本纪明载预计发生日食而未见，可见地点及天象原因待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001629",
      "observations": [
        "各地起事经过与进军日期待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001633",
      "observations": [
        "脱脱不花被杀的具体日未载，保留本纪十二月与《鞑靼传》年条。两条入阁沿年表审定的公元1452年。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p001634",
      "observations": [
        "各贡使实际到达日期待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001637",
      "observations": [
        "金濂获释确日与所违诏文内容待考。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001638",
      "observations": [
        "毛福寿稳定人物键、巴马地点及战事经过待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001639",
      "observations": [
        "易储、废立皇后、封爵分录；河南流民的给粮执行范围与颜孟后人姓名待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001640",
      "observations": [
        "水灾决口确日与损失待考。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001642",
      "observations": [
        "洪英、孙原贞、薛希琏稳定人物键及巡视分工待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001643",
      "observations": [
        "江渊起复异文见卷末校记，保留正文所写，不将其九月另建为起复日。灾区范围和各次灾变日期待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001644",
      "observations": [
        "福建起事人员与银场确址待考。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001645",
      "observations": [
        "卫颍、杨能、张钦稳定人物键待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001646",
      "observations": [
        "日食观测地点以及白石崖地望待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001647",
      "observations": [
        "阮让、杨俊稳定人物键及团营编制定员待核。"
      ]
    },
    {
      "batch": "part-04",
      "paragraph_id": "mingshi-2f603db3d81e-p001648",
      "observations": [
        "各地贡使实际到达日期待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001651",
      "observations": [
        "五开、清浪两地战事分别发生的时间与部队分工待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001652",
      "observations": [
        "建宁银场具体地点与生产范围待考。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001653",
      "observations": [
        "筑决口说的是修堵，竣工时间未见。赈运明细待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001654",
      "observations": [
        "王文正文异文与卷末校记联核，五月为奔丧、九月为起复。徐州、凤阳救济和沙湾决口分条记录。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001655",
      "observations": [
        "林聪奏言内容及何文渊退职确日待考。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001657",
      "observations": [
        "也先称汗保存月日及本纪用词，所用具体尊号待进一步查证。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001658",
      "observations": [
        "徐有贞左、右佥都御史异文见卷末校记；也先来使身份和使命待核。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001659",
      "observations": [
        "太子死因在本段未载。"
      ]
    },
    {
      "batch": "part-05",
      "paragraph_id": "mingshi-2f603db3d81e-p001661",
      "observations": [
        "各地使者到达确日待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001663",
      "observations": [
        "黄河水清持续时间、抚辑各自负责地区和银场停办范围待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001665",
      "observations": [
        "孙贤规范人物键及王文出行确日待核。《麓川平缅传》记此前获俘和交接后送京，本纪庚辰保留为执献条。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001666",
      "observations": [
        "日食观测地域、方瑛封爵确日待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001667",
      "observations": [
        "《章纶传》记两人先后上奏，本纪同列五月甲子下狱。各次上奏日期和后续处置另录。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001669",
      "observations": [
        "水灾实际范围待考。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001671",
      "observations": [
        "原文所列七处共二百余万石，各地数额待考。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001672",
      "observations": [
        "征讨对象、具体战事时地待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001673",
      "observations": [
        "织造采办结束的执行细节待核。"
      ]
    },
    {
      "batch": "part-06",
      "paragraph_id": "mingshi-2f603db3d81e-p001675",
      "observations": [
        "年度回顾未载各贡使入明、也先被杀的具体日期，保留原历年界的公元区间。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001678",
      "observations": [
        "李茂及同行官员的稳定人物键和审录范围待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001679",
      "observations": [
        "日食观测地点和受敕各地后续施行待考。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001681",
      "observations": [
        "职官志用梴，本纪用梃。授职同人，各别原字及开封决口具体点位待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001682",
      "observations": [
        "沙湾堤与后续治河工程范围及南京各次灾异待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001683",
      "observations": [
        "钟同死在狱中，本纪未单标卒日。廖庄奏疏和廷杖各自日期待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001684",
      "observations": [
        "苏州、松江各自所领数额未载。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001686",
      "observations": [
        "方瑛军队实际出发日期与各处地望待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001688",
      "observations": [
        "各贡使到达日期待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001691",
      "observations": [
        "杭皇后死与寿陵工程分录。寿陵营建的具体工序及其与葬皇后地点关系待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001693",
      "observations": [
        "周冕的具体世系代数及这次水旱观测范围待核。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001694",
      "observations": [
        "葬肃孝皇后地名及前后处置见列传，原段未详。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001696",
      "observations": [
        "方瑛各场战事与岁末赈济地点待核。冬季蠲免不强定某日。"
      ]
    },
    {
      "batch": "part-07",
      "paragraph_id": "mingshi-2f603db3d81e-p001697",
      "observations": [
        "各贡使到达确日待核。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001699",
      "observations": [
        "复位在壬午，改元诏据《英宗后纪》另在丙戌。旧年表条将两件事一并叙写，正在卷十二用其独立原文校正。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001700",
      "observations": [
        "卷十一承景泰八年书二月，历表及卷十二在英宗改元后对应天顺元年二月。“年三十”按本纪原说，不从中倒推确切生年。死亡、废为郕王、谥葬各自有时间精度。"
      ]
    },
    {
      "batch": "part-08",
      "paragraph_id": "mingshi-2f603db3d81e-p001701",
      "observations": [
        "恢复帝号有确日，尊谥仪礼及修陵完成日期从原文保留相对次序。制文为明宪宗诏令，其中对前朝的评价归于诏令。"
      ]
    }
  ],
  "next_paragraph": "mingshi-2f603db3d81e-p001711",
  "published": true,
  "publication_verified": true,
