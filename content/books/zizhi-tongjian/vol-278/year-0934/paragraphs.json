    ],
    "book": "资治通鉴",
    "volume": 278,
    "year": 934,
    "batch_key": "zztj-v278-y0934-p001-p007",
    "review": "戊子朱冯石诏加与冯辞、己丑改侍中分。冯诏加不等实际受，旧封邠国公补。朱旧宏主弘异字同人，不造朱宏昭；原同中书门下二品衔不擅改三品。"
  },
  {
    "id": "zztj-v278-y0934-p004",
    "source_line": 98,
    "text": "壬辰，以荆南节度使高从诲为南平王，武安、武平节度使马希范为楚王。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_278_0934_gaoconghui_nanping_king",
      "event_zztj_278_0934_maxifan_chu_king"
    ],
    "book": "资治通鉴",
    "volume": 278,
    "year": 934,
    "batch_key": "zztj-v278-y0934-p001-p007",
    "review": "壬辰两王封授分，既有继位与此唐封王区分，不当此前未管荆南楚，也不将父高季兴马殷误为受封者。"
  },
  {
    "id": "zztj-v278-y0934-p005",
    "source_line": 99,
    "text": "甲午，以镇海、镇东节度使吴王元瓘为吴越王。",
    "status": "published_verified",
    "event_keys": [
