  "pending_paragraphs": [
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000875",
      "observations": [
        "朱允炆父子、祖孙和母子关系据开篇明示身份录入。照料父病、临朝决章奏与刑律减重七十三条的各自起讫待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000877",
      "observations": [
        "继位、安葬同为辛卯，确认为同日不同事。丧礼朝服、居丧和祭祀的完整礼制归入待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000878",
      "observations": [
        "齐泰任尚书月份存异，依据卷末校记分清本纪六月、年表五月和《国榷》闰五月。黄子澄的规范人物键待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000879",
      "observations": [
        "方孝孺任侍讲月份有六月和七月两种记法，均留出处；身份与旧数据另校。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000880",
      "observations": [
        "周王朱橚的规范身份与总的废徙经过待复核；各卫冗役人员范围待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000881",
      "observations": [
        "沐春和何福的规范人物编号和交接详情待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000882",
      "observations": [
        "三位官员的稳定人物键和具体授命、查察范围待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000883",
      "observations": [
        "刀干孟的稳定人物键和战事最后节点待复核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p000884",
      "observations": [
        "两处来使日期分别待考。"
