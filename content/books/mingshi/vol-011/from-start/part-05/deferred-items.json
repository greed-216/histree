{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001651",
      "reason": "五开、清浪两地战事分别发生的时间与部队分工待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001652",
      "reason": "建宁银场具体地点与生产范围待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001653",
      "reason": "筑决口说的是修堵，竣工时间未见。赈运明细待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001654",
      "reason": "王文正文异文与卷末校记联核，五月为奔丧、九月为起复。徐州、凤阳救济和沙湾决口分条记录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001655",
      "reason": "林聪奏言内容及何文渊退职确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001657",
      "reason": "也先称汗保存月日及本纪用词，所用具体尊号待进一步查证。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001658",
      "reason": "徐有贞左、右佥都御史异文见卷末校记；也先来使身份和使命待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001659",
      "reason": "太子死因在本段未载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001661",
      "reason": "各地使者到达确日待核。"
    }
  ]
}
