  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v287-y0947-p049",
      "note": "襄州击退、郢州战败与断汉附唐蜀分录，旧高传补求郢州被拒，依违不当承诺，旬日不反推开战日。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p050",
      "note": "截取贡物、受责归还与多向称臣为跨年概述，年份null；贬称高无赖与高赖子并列，不当正式姓名。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p051",
      "note": "南唐主确认为李璟，宋齐丘任镇南节度使，未补独立无载纪日。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p052",
      "note": "南汉主刘晟与后汉帝刘知远区分；八弟同日死据新史，弘洪及伟暐照昭异文沿已有主体；尽杀其男指诸弟子女，酷刑与乐工旧事日期未知。推荐李涛沿已核后晋宋初身份，张彦译疑字保留不创同名。婚姻事实与慕容指控区别；拟相、亲征提议、诏令、正式任命与留守分录。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p053",
      "note": "返回镇州与己卯授官不同纪时，太子三师职不自动证明已立具体太子。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p054",
      "note": "庚辰发大梁与戊寅诏及十月到邺分别记录。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p055",
      "note": "归蜀请求及终南路援军请求不当已经出兵或到达。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p056",
      "note": "戊戌到邺与旧丙申后叙抵达位置保留异说；粮尽为建议预期，高塞粪主体明确；密报和解令、责彦超令谢分别区分执行与命令。"
    }
  ],
  "source_issues_review": "南汉八王名单保留弘洪、伟暐、照昭及恩息宜宣王号异文；刘知远抵邺戊戌与旧本纪丙申后叙位置不同。张彦译与张彦泽为疑字不新建主体。",
