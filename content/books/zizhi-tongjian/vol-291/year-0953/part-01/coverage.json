  "coverage": "卷291原33—42行连续十段；953年共46正文，后续尚未完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v291-y0953-p001",
      "note": "主书四项正式授职与旧纪张仿、朱元琇补任分开；领刺史不写迁往该州，何敬真贞和朱全元姓名异文有同日军府与后续同人记载。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p002",
      "note": "诏书招抚条件、李万全等立誓及仍不服者讨伐为奏报层次，未补已全部受赏或灭族。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p003",
      "note": "此前制度与953改革分开；朱温掠牛未知战役年，牛死租留为制度延续。户部增户为改隶登记可能，未写出生户；原肥铙字保留，展示肥沃。旧书先有例外与后续归县分别补证。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p004",
      "note": "叶仁鲁赃额、赐死与郭威赐酒食承诺分开，前刺史与刺史称谓保留，母亲未具名不造实体。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p005",
      "note": "河决巡视、王峻阻柴荣入朝、闰月获准分开；旧书辛未日期作为巡视补证。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p006",
      "note": "义丰军夜袭与镇州驱敌分开；旧纪辛卯甲午为奏报日，六十级和追至无极仅作补充。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p007",
      "note": "柴荣入朝、马全乂随行获任及王峻戊戌返回分录；全乂全义按同经历同职同赞语对应，故为旧骑士，不误读已死。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p008",
      "note": "父死、隐丧谋继、杀李彬及诬报谋反分录；旧纪丁未登记与主书死亡时点不强等同，父子方向明确。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p009",
      "note": "求兼藩镇与壬寅获任同一事件，旧纪青州与平卢治所对应，原中央职保留。"
    },
    {
      "paragraph_id": "zztj-v291-y0953-p010",
      "note": "反复奏报是谋继，巡检促公开父丧不当实际死亡发生日，未凭同名合并李彬。"
    }
  ],
  "source_issues_review": "全乂与全义、敬真与敬贞、全琇与元琇按职务行动连续校核，原字保留。肥铙疑字只在展示释义，死亡与奏报区别清楚。纸本异文未核。",
  "plain_language_review": "首次逐条核对全部展示字段，人物姓名、动作、角色与关系方向明确；制度回述、建议条件、任命执行、计划与奏报分别说明。引文保持底本原字。"
}
