  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002265",
      "reason": "核对卷内世系、皇后和立储。旧身份出处与本段完全同源，复用原编号。性情记述保留原文。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002267",
      "reason": "武宗即位的日期依本纪。大赦、免逋赋和定年号未独列干支。小王子身份待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002268",
      "reason": "王氏为前朝皇太后。周氏已于弘治十七年去世。张氏为朱厚照之母。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002272",
      "reason": "两次贡使实际到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002278",
      "reason": "风雨据“是日”连到前书辛酉。陕西蠲税另无独立日，仍取月级。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002280",
      "reason": "八名内臣完整名录另见卷304。初次奏劾、再请、各内臣任用与大学士去留分录；各内臣任职确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002283",
      "reason": "各次贡使到达日期待核。"
    }
  ]
}
