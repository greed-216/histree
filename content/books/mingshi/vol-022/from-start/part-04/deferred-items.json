    {
      "paragraph_id": "mingshi-2f603db3d81e-p003586",
      "reason": "王恭厂灾变原因与确切死亡人数留待其他史料校核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003587",
      "reason": "灵丘连续地震的起止日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003588",
      "reason": "闵梦得按校记，别本叶梦得保留；各地建生祠、地区灾情确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003589",
      "reason": "七月初一原文为应食而未见；刘铎入狱和死日需分别核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003590",
      "reason": "本纪未记陕西起事各部姓名与各次行动日期。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003591",
      "reason": "杨明辉遇害确日及各地灾情范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003592",
      "reason": "受升授具体名册待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003595",
      "reason": "各方贡使抵达日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003597",
      "reason": "两位内监漕运任命确日和核查结果待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003599",
      "reason": "后金出兵朝鲜的分日及各方记载待校。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003600",
      "reason": "王之寀的入狱日已核，遇害确日另查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003603",
      "reason": "魏鹏翼亲属称谓暂并存本纪“孙”与本传“从孙”，浙江各地水情与海上武装身份待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003604",
      "reason": "魏良栋获封确日及乾清宫受召名单待核。遗诏、朱由检即位按后续本纪分记。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003605",
      "reason": "葬陵日按卷23分核，保留本段叙事。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003609",
      "reason": "罗一贵或罗一贯的姓名异写，仍需核同一身份。"
    }
  ]
