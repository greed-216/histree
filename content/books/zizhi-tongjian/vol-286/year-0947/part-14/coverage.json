  "coverage": "卷286原81—90行连续十段，累计85/92，947年未完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v286-y0947-p076",
      "note": "方太武定与洋州职衔异写保留；郑王为被迫；朱乙出家未知年；攻城败退、谮告、师朗受害、暂留守、杀朱、伊阙迎击与被诱杀逐项分录。旧史夹引通鉴不作独立补证。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p077",
      "note": "护送刘晞回洛阳与因怀疑杀潘环分开，牟谟同人，怀疑不当确证。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p078",
      "note": "武行友戊辰抵达与前批派遣启程分记。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p079",
      "note": "庚午为奏报日，千余为战果报告；耿崔南退与马追获胜分清，奚王沿既有待考主体。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p080",
      "note": "辛未正式授河阳节度与前批占城推都部署分开。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p081",
      "note": "三失为耶律德光自述归因，不是完整历史因果；劫掠词义按语境。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p082",
      "note": "壬申赦议斩、江弹劾批评、被贬、押送、宋待罪、诏流放、徐韩请斩及不从逐项分录；指控观点不压成独立事实，徐籍贯异说保留。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p083",
      "note": "延己沿延巳主体；主书太弟少保与新史少傅差异保留；太子洗马保官名。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p084",
      "note": "韩的警告与宋指控及实际贬谪分清，和州司士参军、司马异写和动机差异保留。"
    },
    {
      "paragraph_id": "zztj-v286-y0947-p085",
      "note": "乙亥归附，石奉頵宗属不推具体亲属连接。"
    }
  ],
  "source_issues_review": "方太与南唐诸官异衔、徐铉籍贯、韩被贬动机差异分别保留；师朗同名区别；议斩未当执行；奚王先前身份疑问不消除。",
  "plain_language_review": "首次逐项核对全部人物事件标题说明、角色、关系、日期地点、出处和事实说明；明示主语、怀疑指控言论和实际动作，出家追叙未知年，引用字形保持底本。"
