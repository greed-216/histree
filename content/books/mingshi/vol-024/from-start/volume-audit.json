  "pending_paragraphs": [
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003774",
      "observations": [
        "梓潼之战另见国榷、明史稿二月乙未，保留异日。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003776",
      "observations": [
        "曹变蛟追战及李自成各段行军确日未载。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003778",
      "observations": [
        "安民厂灾具体原因、伤者统计与各省旱蝗详情待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003780",
      "observations": [
        "罗汝才从陕州出兵、抵襄阳确日待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003781",
      "observations": [
        "墙子岭各地战事、同遇难将士名单待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003782",
      "observations": [
        "潼关南原战和两路督援任命分别的确日待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003783",
      "observations": [
        "卢象升被罢有跨公元年异说；刘宇亮出师、罗汝才受降日待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003784",
      "observations": [
        "卢象升战亡确日和洪承畴领军入卫执行日待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003785",
      "observations": [
        "各地贡使抵达日待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003787",
      "observations": [
        "济南其他遇难官员及晋州所会各路军和兵数待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003788",
      "observations": [
        "清军所下各城与退军分段的日期待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003789",
      "observations": [
        "李万庆归降确日待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003790",
      "observations": [
        "魏炤乘、本纪魏照乘已据官职时点确认同人，孙传庭下狱的确日待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003791",
      "observations": [
        "旱蝗范围、抽练兵额及实际练饷待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003792",
      "observations": [
        "罗猴山多种写法，具体地望待核。熊文灿下狱确日待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003793",
      "observations": [
        "杨嗣昌督师纪月有异，待分清任命和到任。其他获罪者完整名单待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003794",
      "observations": [
        "左良玉任平贼将军有跨公元年纪月异说。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003797",
      "observations": [
        "琉球贡使到达日期待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003800",
      "observations": [
        "玛瑙山战依校记订戊午；丙辰可能另指会师。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003801",
      "observations": [
        "魏藻德同榜名录和河北各府免赋额度待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003802",
      "observations": [
        "解学龙与黄道周审案详情待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003803",
      "observations": [
        "秦良玉在夔州各次分战确日待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003805",
      "observations": [
        "孙应元按校记；罗汝才、张献忠会合确日待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003807",
      "observations": [
        "剑州、绵州独立失守确日待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003810",
      "observations": [
        "河南各城失守以及万安王遇害的具体纪日待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003811",
      "observations": [
        "灾区分季范围、受灾人数待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p003813",
      "observations": [
        "河南指河南府，其他遇难者名录、黄陵城各将士伤亡待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p003814",
