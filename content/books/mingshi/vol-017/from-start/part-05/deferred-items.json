  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002571",
      "reason": "太宗为祭祀当时朱棣使用的庙号。桂萼因病赴归的阶段待其本传详核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002577",
      "reason": "叶相稳定人物键待核；张孚敬即前条赐名后的张璁。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002579",
      "reason": "明史以追改后庙号“成祖”叙西苑礼仪，尊号沿用与当时文书应分辨。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002581",
      "reason": "喻希礼、石金同疏与分别定罪、发戍的确日另待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002585",
      "reason": "林大钦及其他同科登第人员稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002586",
      "reason": "四位功臣实际获封后人的名号须依卷105至107查核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002588",
      "reason": "受封的刘基后人名讳待查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002592",
      "reason": "杨名被关押、判定和遣戍的细分日期待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002593",
      "reason": "宋沧稳定人物键及具体上表不详。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002595",
      "reason": "各次贡使到达日期待核。"
    }
  ]
}
