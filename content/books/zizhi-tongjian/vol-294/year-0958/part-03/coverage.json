  "excluded_non_body": [],
  "coverage": "原22—29行连续八段，后续未计。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v294-y0958-p017",
      "note": "辛卯临江水战、派水陆循江、主甲午旧乙未奏胜、李重进趋庐、李璟请求传位、丙申陈献四州获许、丁酉遣刘致国主书、戊戌吴援舰合计分阶段。东拆字据旧㳍组合展示不改州洲地理；慕容宋早履父章、邵新常州丧匿名子是此前背景不放958。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p018",
      "note": "刘再表称国主献四州与岁贡约数、十四州六十县区域总结分开，旧己亥补表日与户数非人头，交割条件未全执行。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p019",
      "note": "庚子主书与旧己亥条合载信纪时并列，近外近内异字原保；退军和等南唐家属启程交城是安排。辛丑不必传位答复非太子已经即位。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p020",
      "note": "壬寅迎銮返扬州与二月到扬州分别记。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p021",
      "note": "癸卯吴荆军归道、钱三万匹高一万匹为帛，不现代币，钱名拆字沿已有弘俶。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p022",
      "note": "保信军主甲辰旧壬寅改号，赵授节度同甲辰；旧赵赞按同职同日关联赵匡赞，不合早期另一裸赵赞。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p023",
      "note": "丙午冯延巳名已核，银两绢匹钱贯茶斤谷石分别列，合百万不是统一价值。"
    },
    {
      "paragraph_id": "zztj-v294-y0958-p024",
      "note": "己酉水军三千巡警为新任务，未载巡程终点，不补战役。"
    }
  ],
  "source_issues_review": "东氵布与東㳍字形组合有据、地理未定；奏胜甲午乙未、保信改号甲辰壬寅、近外近内各保异说。冯延己巳既有同人，赵赞按任务关联不误合早裸赵赞；吴越新史合叙不能给常州败战挪年，原快照复用既有出处。纸本待核。",
  "plain_language_review": "首次逐条核对人物角色、标题正文、父亲方向与事实解释。情报和计划、传位请求与拒绝、献地允诺与实际待交条件、称国主与五月仪制落实分开；统计户数、物资多单位、帛赏均不换成统一钱额，原文保字。"
}
