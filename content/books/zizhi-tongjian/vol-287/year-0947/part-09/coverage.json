  "coverage": "卷287原70—80行连续十一段，本卷947年75/75；跨卷286及287累计167/167，须公开读回与年度审计通过后标完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v287-y0947-p065",
      "note": "辛卯死亡与旧史甲午不同，孝友忠厚等评价归史家，死亡地点未定。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p066",
      "note": "癸巳到京与丙戌启行区别，旧史相合。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p067",
      "note": "李孺赟沿李仁达，谋袭杀及再降唐意图与鲍发兵杀夷族的实际行动分清；是日不套前癸巳，具体族人未名。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p068",
      "note": "乙未追封与旧甲午条附封保留，不写成生前封王。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p069",
      "note": "侯赵联名请蜀出兵、送兵粮帐与完成移居归蜀区别，宋侯传归蜀及后续改意保留。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p070",
      "note": "己酉首级到钱塘不当杀李日，吴程知威武事务不当已到福州。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p071",
      "note": "继位后杀三吏为回叙，不硬定十二月，未名吏不建人。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p072",
      "note": "想授一州未执行、驳议祭先王、杀牛案供述与问答、胡自觉受辱、因李叛受责、驱逐谋议与水丘劝忍、何反告逐项分录；历史斤未换现代重量，查吏未造量刑，何承训不误作刘承训。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p073",
      "note": "庚戌晦夜宴疑杀与实际带兵拘禁、假风疾传位、迎俶召元、元见新君才拜、假称王命授职、保兄承诺后理事分录；宋俶传补身份顺序，新史题图疑杀不能当已证暗杀。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p074",
      "note": "鹿光铉光弦同段异字为同人，舅父方向明确不造母名；杀水丘与胡妻责问分录，不造胡妻名。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p075",
      "note": "是岁王延政任安化与鄱阳王镇饶州不强定十二月，前闽主非复国。"
    }
  ],
  "source_issues_review": "刘承训死亡辛卯与旧甲午、追封乙未与旧附条异说；李孺赟更名沿李仁达，钱弘俶弘亻叔、鹿光铉光弦异字保留。原快照夹948开头，本批仅947正文原70—80行。",
  "plain_language_review": "首次全字段白话、身份时间及引用自查；明确主语，假称命令与真实行动、谋议与执行、当事人认知与史家评价分清。未明月日不补，逐字摘录保持底本原字。"
}
