    {
      "id": "mingshi-2f603db3d81e-p000946",
      "book_key": "mingshi",
      "book": "明史",
      "source_version": "2f603db3d81e",
      "section_id": "mingshi-2f603db3d81e-s0006",
      "section_title": "卷五",
      "section_kind": "volume",
      "volume_candidate": 5,
      "volume_part": "",
      "volume_verified": false,
      "structural_volume_verified": true,
      "kind": "body",
      "text": "秋七月癸酉，匿壯士端禮門，紿貴、昺入，殺之，遂奪九門。上書天子指泰、子澄為奸臣，幷援祖訓「朝無正臣，內有奸惡，則親王訓兵待命，天子密詔諸王統領鎮兵討平之」。書既發，遂舉兵。自署官屬，稱其師曰「靖難」。拔居庸關，破懷來，執宋忠，取密雲，克遵化，降永平。二旬眾至數萬。",
      "boundary_basis": "epub_source_paragraph",
      "review_status": "pending",
      "flags": [],
      "locator": {
