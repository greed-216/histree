{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003740",
      "reason": "南京大震依本句上下文释为警讯所引发的惊动。老回回具体身份待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003741",
      "reason": "朝鲜降清另有朝鲜、清方纪日，保留本纪月说。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003742",
      "reason": "刘同升同科进士名录与酆家店参战人员待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003743",
      "reason": "皮岛后续兵员变动、汉南战事确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003744",
      "reason": "熊文灿任命确日、各部驻防经过待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003745",
      "reason": "旱灾实际范围和时长待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003746",
      "reason": "山东、河南受灾各地具体范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003747",
      "reason": "授命和实际到任分开核，所阅城防部位待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003749",
      "reason": "诸城分别失守日期及侯良柱确切交战地望待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003751",
      "reason": "本纪黄士俊致仕与年表及所引实录纪日有异，保留两说。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003752",
      "reason": "各地贡使到达确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003755",
      "reason": "驿站裁减纪月异说仍存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003756",
      "reason": "高从龙战死日期异说仍存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003757",
      "reason": "王嘉胤败死地望、月份两说见3664段。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003758",
      "reason": "内臣监视之纪日异说仍存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003759",
      "reason": "杨鹤被逮及发戍时间分别存异。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003761",
      "reason": "刘宇烈被逮有两种时间记载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003762",
      "reason": "五岭山战事本纪、明史稿及实录纪日有异。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003763",
      "reason": "厂灾地名有异，见3708段。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003764",
      "reason": "随州战二月、三月两种月份并存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003765",
      "reason": "樊城兵变两月三日说仍存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003767",
      "reason": "撤内臣跨年异说仍存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003768",
      "reason": "汤九州官名及战败月说仍存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003769",
      "reason": "陈起新与陈启新均由本卷校记保存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003770",
      "reason": "黄士俊离任年号和月份异处，公元年同为1638。"
    }
  ]
}
