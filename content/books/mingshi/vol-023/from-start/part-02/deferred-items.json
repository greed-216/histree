{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003638",
      "reason": "裁驿站在不同史源有二月、四月之异，暂同存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003639",
      "reason": "进犯三水、高从龙战歿之日期有四月丙戌与闰四月癸亥之异。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003641",
      "reason": "双岛的历史地望与处置毛文龙的具体议罪材料待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003642",
      "reason": "水西战事此一阶段结束，红土川位置和其他记录日期仍需考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003645",
      "reason": "京师勤王诏、孙承宗受召、王洽下狱及狱中死日分别待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003646",
      "reason": "马世龙总理援军的确日、山海关各军到达经过待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003648",
      "reason": "永平殉难官员全名单、刘策后续论死日期与执行待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003652",
      "reason": "三地各自恢复日期待考，依本纪保留相继恢复。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003653",
      "reason": "邵雍后裔获授者姓名、张献忠起事确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003654",
      "reason": "袁崇焕案各史源所记狱案与死因评议待校，本段仅据本纪录处死。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003657",
      "reason": "怀宁具体地名、参战人名待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003659",
      "reason": "贡使抵达确日待核。"
    }
  ]
}
