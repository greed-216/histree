  "coverage": "原80—87行连续八段，从寿州围攻至赵匡胤装束对话；未来献皇甫晖等段未计覆盖。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v292-y0956-p007",
      "note": "永宁讲话里的饿殍为忧虑，甲寅换帅、丙辰围城迁桥、丁巳征夫、涂山设营与涡口命击交战分别处理。淝水之阳按北侧，毫疑亳保留；庚申命战与壬戌奏报区分。"
    },
    {
      "paragraph_id": "zztj-v292-y0956-p008",
      "note": "湖南任统帅、岳州宴犒、左右索求及谋反指控分阶段；谋叛为谗言，不记作已确认叛乱，未来潘叔嗣行动不提前。"
    },
    {
      "paragraph_id": "zztj-v292-y0956-p009",
      "note": "李璟命迁民、何敬洙反对及备战表态、君主认可分别说明，俱死是决心非实际全体死亡。"
    },
    {
      "paragraph_id": "zztj-v292-y0956-p010",
      "note": "丙寅桥成及柴荣察看独立于此前迁桥命令。"
    },
    {
      "paragraph_id": "zztj-v292-y0956-p011",
      "note": "盛唐奏报、旧高弼获释、清流山后进兵、滁州追击伤俘与旧引默记先败后胜异说并列；壬申奏报非强定战日。宣祖赵弘殷由宋本纪祖系识别，宋父子记载与主对话明确方向；夜门后数日不推精确日。"
    },
    {
      "paragraph_id": "zztj-v292-y0956-p012",
      "note": "府库登记、拒绝无诏取绢及认可、命知滁州分开，旧宋同快照复用。马崇祚契丹与后周同名无连续履历，新增限定名待核。"
    },
    {
      "paragraph_id": "zztj-v292-y0956-p013",
      "note": "遗表荐、范质荐任、交谈认可、先审救活分开，父子与推荐关系各有引文，推荐阶段限定。赵普七八成不换精确人数，旧事无确日不强955956。"
    },
    {
      "paragraph_id": "zztj-v292-y0956-p014",
      "note": "临阵习惯与回应为无确时概述，留year null，不创建虚构某日披甲战役。"
    }
  ],
  "source_issues_review": "庚申命战与壬戌涡口奏报、清流戊辰后叙与壬申奏报分清；旧引默记先败后胜异说保留。庐拜职辖及毫字保留待核。马崇祚分档，宋宣祖身份及父子方向由同节祖系回查。",
  "plain_language_review": "首次逐条自查主语、称号、角色、事件和时间解释，父亲与推荐方向明示；无确年旧事留null，诏令与桥成、伤俘与死亡、谗言与事实、人数约数与精数分清，原文不改。"
