  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v269-y0915-p025",
      "note": "“初”引婚姻旧事，确年未载；张氏九月受册及死亡为915年事，未立皇后。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p026",
      "note": "通鉴电子本康王作友敬，旧五代史、新五代史作友孜；同号同年同事复用朱友敬UUID并补朱友孜别名，纸本仍待核。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p026",
      "note": "“以至于亡”为后见总评，赵张用事叙事不全标作915年；旧书对康王伏诛与通鉴壬子记日不同。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p027",
      "note": "蜀宫火新旧书细节不一；主书仅说明卫兵欲救、蜀主拒入，不推断原因。"
    },
    {
      "paragraph_id": "zztj-v269-y0915-p028",
      "note": "蜀大赦与宫火先后相邻，尚无明确因果证据。"
    }
  ]
}
