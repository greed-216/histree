        "line_start": 7707,
        "line_end": 7707,
        "raw_excerpt_sha256": "56fe78d8d3e503fdcc665f6efd87205068a3779bbab3e558cc23855c775288ec",
        "epub_member": "OPS/c24_ming_shi_juan24.xhtml",
