  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002656",
      "reason": "黄绾是出使命令，和到安南的实施阶段分开。曾质粹、莫方瀛稳定人物键待核。“北獄”为底本原字，疑“北嶽”，与下段“望於中嶽”可对照。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002657",
      "reason": "祭告、赦令和赋役减免细节可再核礼志。行宫地点与年月留原文。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002660",
      "reason": "王杲赈灾条未另标日，按九月保存。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002663",
      "reason": "各次贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002665",
      "reason": "翟銮奉召与实际回京细节仍待考；周岐稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002667",
      "reason": "瓦剌部首领的称名待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002670",
      "reason": "黑水苑、铁柱泉两次战事分录，日期和任杰稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002673",
      "reason": "各次贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002677",
      "reason": "沈坤及同科名录、郑东身份和兰州阵亡确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002678",
      "reason": "莫登庸归顺过程另见卷321，此条保存改机构和任命的朝廷处置日。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002681",
      "reason": "阿不孩规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002682",
      "reason": "赵卿和阿不孩稳定人物键待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002683",
      "reason": "郭勋下狱及死狱中按卷130所载分别落时；后者详日按《世宗实录》卷267订为次年十月乙酉。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002685",
      "reason": "本纪“敬皇后”按上下文和卷114核定为孝宗张皇后。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002686",
      "reason": "贡使到达日期待核。"
    }
  ]
}
