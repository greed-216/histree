  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002096",
      "reason": "发遣的原文数语保留约数，复核重囚和公布审理原则是不同阶段。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002098",
      "reason": "卷119分别有五王传。本纪泾王句省名中一字，按列传核对。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002099",
      "reason": "丙辰确为告知皇长子出生令的日期，出生本身的确日待核。河溢具体地望待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002101",
      "reason": "土地交割范围及土鲁番使臣行程待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002102",
      "reason": "贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002106",
      "reason": "获录功臣后代、古田战事参与人的规范人物键及具体地点待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002110",
      "reason": "顾溥、邓廷瓒、江悳稳定人物键与会师地点待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002112",
      "reason": "定罪案由与后续处置另见卷119，保留月日明确的废为庶人。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002113",
      "reason": "火剌札国具体指称与贡使日期待核。"
    }
  ]
}
