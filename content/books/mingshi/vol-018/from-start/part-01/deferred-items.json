      "paragraph_id": "mingshi-2f603db3d81e-p002708",
      "reason": "俺答春季屡次入塞仅有季节范围，各次边警确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002709",
      "reason": "吴瑛稳定人物键待核。确切出战日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002710",
      "reason": "陈舜身份和具体战点待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002712",
      "reason": "各贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002716",
      "reason": "秦鸣雷稳定人物键和同科登第人员待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002717",
      "reason": "黑山的具体地望和战日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002720",
      "reason": "甲戌、戊寅和乙酉分别记录入境、侵掠及下狱。谪戍、受廷杖和死亡的确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002723",
      "reason": "日本使团原委和接待确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002726",
      "reason": "张汉被捕与定谳谪戍区分阶段。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002728",
      "reason": "太庙工程有确日，灾区免税按是夏保留季节。"
    }
  ]
