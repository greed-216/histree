  "textual_reviews": [
    {
      "paragraph_id": "zztj-v269-y0914-p012",
      "note": "王宗训“不法”是史书评价，事实层分别记录擅回成都、王建命卫士殴杀及随后人事任命；灌江陵只为未实施提案。"
    },
    {
      "paragraph_id": "zztj-v269-y0914-p014",
      "note": "潘仓嶂、山口城、武侯岭和大度河各战按原文次序分开；伤亡数量是主书口径，未合计。新五代史作大渡河。"
    },
    {
      "paragraph_id": "zztj-v269-y0914-p015",
      "note": "王宗鐸繁体名规范作王宗铎，原文原字保留。"
    },
    {
      "paragraph_id": "zztj-v269-y0914-p016",
      "note": "李继徽＝杨崇本有旧五代史卷13明文；其子仅称彦鲁，暂不自造姓。通鉴、新五代史置914年，旧五代史卷13作911年，卷8“去岁”可与914年合。"
    }
  ]
}
