  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002597",
      "reason": "本段河南巡抚吴山与嘉靖十四年才中进士、字曰静的同名人分开，稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002600",
      "reason": "乙未对应赦令，皇子具体出生时辰或早一日的记载待校，不将赦令日期直接当作出生日期。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002602",
      "reason": "与嘉靖三年张文锦案分录。本纪将代王出走同条叙述，列传另分兵乱阶段。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002605",
      "reason": "各次贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002608",
      "reason": "列传另记詹荣、樊继祖等参与大同平乱，分别核对响应、平乱和后续善后日。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002609",
      "reason": "任杰规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002612",
      "reason": "花马池来军指称待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002614",
      "reason": "贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002618",
      "reason": "卷114同记夏皇后合葬康陵。下葬、后来改谥分别登记。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002619",
      "reason": "费宏召命依据卷末校记采用七月戊子，八月实际入阁另系表中。韩应龙稳定人物键及同科名录待核。广宁兵乱诱因待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002620",
      "reason": "据卷200、211稳定鲁纲身份；同一人先前任总兵、都督的两处暂缓参与据此后续补挂，大同战事确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002625",
      "reason": "贡使到达日期待核。"
    }
  ]
}
