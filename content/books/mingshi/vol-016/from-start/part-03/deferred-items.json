  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002310",
      "reason": "张彩规范人物键从七卿年表，正文写张綵；考察细目待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002313",
      "reason": "义州军变的参与者、地点和起因待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002314",
      "reason": "小王子、总兵吴江的规范键和陇州城地望待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002315",
      "reason": "原文花马池，防边战斗具体地点和来军归属待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002316",
      "reason": "保留本纪所载总数，具体名单待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002317",
      "reason": "各处起事的具体时点及贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002321",
      "reason": "洪钟正字另见卷末校记。七卿年表与本纪的职任表述各自保留，王哲稳定人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002322",
      "reason": "安惟学稳定人物键、张永确切任命日与其到达时间待核。仇钺擒获朱寘鐇据本纪“是日”。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002324",
      "reason": "本纪记刘宇六月丙午被罢，宰辅年表另记逾年致仕。二者处分是否同一阶段继续核对。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002326",
      "reason": "正德二年以后更改政令的具体清单、获释大臣名单待考。刘瑾下狱与处死依干支分录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002327",
      "reason": "受封各人稳定身份、具体爵号待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002329",
      "reason": "吴景身份及攻陷江津者的来历待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p002330",
      "reason": "各次贡使到达日期待核。"
    }
  ]
}
