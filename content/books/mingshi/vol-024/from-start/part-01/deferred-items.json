{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003774",
      "reason": "梓潼之战另见国榷、明史稿二月乙未，保留异日。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003776",
      "reason": "曹变蛟追战及李自成各段行军确日未载。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003778",
      "reason": "安民厂灾具体原因、伤者统计与各省旱蝗详情待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003780",
      "reason": "罗汝才从陕州出兵、抵襄阳确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003781",
      "reason": "墙子岭各地战事、同遇难将士名单待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003782",
      "reason": "潼关南原战和两路督援任命分别的确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003783",
      "reason": "卢象升被罢有跨公元年异说；刘宇亮出师、罗汝才受降日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003784",
      "reason": "卢象升战亡确日和洪承畴领军入卫执行日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003785",
      "reason": "各地贡使抵达日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003787",
      "reason": "济南其他遇难官员及晋州所会各路军和兵数待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003788",
      "reason": "清军所下各城与退军分段的日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003789",
      "reason": "李万庆归降确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003790",
      "reason": "魏炤乘、本纪魏照乘已据官职时点确认同人，孙传庭下狱的确日待考。"
    }
  ]
}
