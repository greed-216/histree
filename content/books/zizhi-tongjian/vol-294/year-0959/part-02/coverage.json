  "excluded_non_body": [],
  "coverage": "原78—88行连续十一段，后续24段尚待录入。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v294-y0959-p010",
      "note": "甲子、丁卯、甲戌为三月北征部署与出发，当前主书未另标三月，用旧史月序说明。留京官权摄与永久任职分开；旧史昝居润副使作补充。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p011",
      "note": "庚寅为韩通水道工程奏报日，不填各项施工起止。栅、堤、三十六游口在水道语境解释，不移成城门或精确现代闸门。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p012",
      "note": "辛卯至沧州出军、壬辰王洪归降分开；王洪以宁州职务限定。辽史补契丹任萧思温应敌，来侵和任命日按该书，不移用主书沧州日。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p013",
      "note": "乙未水陆使职、丁酉龙舟、己亥独流转西、辛丑益津归降、舍巨舰、壬寅宿野依序分录。今上和太祖指赵匡胤；旧注终廷晖引通鉴注明依赖，不算独立确证。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p014",
      "note": "癸卯赵匡胤先至、姚内斌降、柴荣入关；宋传补卢龙籍、五百归降与汝州任职。宋代避讳改名为后续合叙，原名未完整载不猜补。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p015",
      "note": "甲辰莫州、乙巳朔瀛州与李重进继至分明。当前主书正月为月序异常，新旧史明确五月，原引文不改。辽史五月朔合叙瀛莫、四月三关与旧史户数范围分别保留。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p016",
      "note": "议幽州未遂、刘重进奉命固安、安阳水作桥与患病停止、契丹急使、北汉闻南归罢兵依序。刘重进与契丹通事同名者分开，罢兵是消息后的后续不强定丙午。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p017",
      "note": "戊申奏报下易州，擒献斩不是全部同日确证；孙行友同义武定州节镇，李在钦死亡年由本年记载支持。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p018",
      "note": "己酉建雄霸及县属、发夫筑城分清，不造国界坐标。旧史和宋传补张藏英同战役实际取固安，与此前刘重进受命不同人不同日期，不强合。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p019",
      "note": "庚戌攻北汉令、辛亥驻雄霸、壬子南还、己巳战报、甲戌回京分开。辽史辛未周兵退另存观察差别；北井百井、二千余二千保留，不认北井为北京。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p020",
      "note": "乙亥李筠取辽州奏、张丕张丕旦同战姓名异文，旧史戊子送俘诏释作后续补充。丙子原武河决与旧史戊寅条后未独标日、二万余二万差别保留，堵口为命令非已竣工。"
    }
  ],
  "source_issues_review": "逐段校核角色、时间、行军顺序和引文。五月误作正月、莫鄚地名、北井百井、张丕张丕旦、二千余及二千等差别保留；旧史引通鉴和宋史注明书证依赖。地理坐标、纸本及河道复原尚待校核。",
  "plain_language_review": "首次逐条检查标题、人物说明、参与角色、时间地点解释和事实说明，明确主语与动作；区分命令、奏报、施工、归降、编制调整、患病及撤兵。引用保留底本原字，不安排固定发布后二次改写。"
}
