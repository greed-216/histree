      "volume_candidate": 16,
      "volume_part": "",
      "volume_verified": false,
      "structural_volume_verified": true,
      "kind": "body",
      "text": "八月己卯，兵部侍郎陸完將邊軍討賊。四川巡撫都御史林俊擒斬賊首藍廷瑞、鄢本恕。甲申，賊劉六犯固安。丙戌，召張偉、馬中錫還。",
      "boundary_basis": "epub_source_paragraph",
      "review_status": "pending",
      "flags": [],
      "locator": {
