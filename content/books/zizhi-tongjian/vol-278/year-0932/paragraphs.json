    "review": ""
  },
  {
    "id": "zztj-v278-y0932-p024",
    "book": "资治通鉴",
    "volume": 278,
    "year": 932,
    "source_line": 29,
    "text": "大同节度使张敬达聚兵要害，契丹竟不敢南下而还。敬达，代州人也。",
    "status": "pending",
    "event_keys": [],
    "batch_key": null,
    "review": ""
  },
  {
    "id": "zztj-v278-y0932-p025",
    "book": "资治通鉴",
    "volume": 278,
    "year": 932,
    "source_line": 30,
    "text": "蔚州刺史张彦超本沙陀人，尝为帝养子，与石敬瑭有隙；闻敬瑭为总管，举城附于契丹，契丹以为大同节度使。",
    "status": "pending",
    "event_keys": [],
