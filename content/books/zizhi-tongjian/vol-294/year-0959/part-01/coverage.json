  "coverage": "原69—77行连续九段，后续35段尚待录入。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v294-y0959-p001",
      "note": "接续958年末合谋，959正月癸丑实际遇害。旧史本传正月七日夜与安万合参与补证；本纪壬戌为奏报日，不当遇害日。C061损字引用保留，处死含义用旧史补证。安守忠父系经宋史本传核对。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p002",
      "note": "问乐工与窦俨考正为追述，具体日期不定。王朴上疏正月由旧史本纪支持，礼乐作用与兴废为奏疏论述；古人不是959当场参与者。殷盈孙、萧承训制器旧事年月未知，钟数与异字保留。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p003",
      "note": "制尺、黄钟管、十二律与十三弦律准按史载参数整理，不换算现代尺寸音高。八十一调与旧史八十四调保留差别；奏请、百官详议和实行分清，不认为所有曲目已编成。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p004",
      "note": "锁宅、墙洞给食、自缢与谥号分别记录。宋齐丘自述幽让皇帝族指杨溥家族，不作报应实证。新旧史放归赐死及显德五年合叙与主书959接续分别保留。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p005",
      "note": "常梦锡参与机政、党争、罢院及去世是追述，死亡年不强定959。罢宣政院与此前严续代其职不直接混同。959追赠不是在世任职，死者不作赠官现场参与者。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p006",
      "note": "二月丙子汴口任务与旧传三月返朝有月份阶段问题，保留。壬午命发夫与旧庚辰发夫分别记录。吴廷祚、吴延祚按使职链关联；袁彦与袁彦超分开。丁夫人数、路线及通漕目的不作竣工证据。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p007",
      "note": "十万二千余顷、四万二千余顷、三万八千顷是田额不同数字，不改为税钱；各州仿减不意味着逐州同额。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p008",
      "note": "借米与不强求必偿分明，不强推全数免债法令。父子为救灾比喻，不作血亲。"
    },
    {
      "paragraph_id": "zztj-v294-y0959-p009",
      "note": "死亡年959、纪日庚申。新旧史明确三月，当前通鉴二月条后无三月标题，保留底本编排问题。旧传补李谷宅发病、四十五岁及追赠侍中，不诊断病名或反推现代周岁生年。"
    }
  ],
  "source_issues_review": "逐段核对身份、官职、时间和逐字引用。安审琦奏报与遇害、王朴月序及调数、宋齐丘死亡合叙差别保留；C061损字不直接改写原文。纸本和地理坐标尚待核。",
  "plain_language_review": "首次逐条检查标题、人物描述、参与角色、事件正文和核对说明，明确主语，区分追述、奏请、命令、实行、评价及追赠；原文引用保留底本字形，不安排固定发布后二次改写。"
}
