{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003791",
      "reason": "旱蝗范围、抽练兵额及实际练饷待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003792",
      "reason": "罗猴山多种写法，具体地望待核。熊文灿下狱确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003793",
      "reason": "杨嗣昌督师纪月有异，待分清任命和到任。其他获罪者完整名单待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003794",
      "reason": "左良玉任平贼将军有跨公元年纪月异说。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003797",
      "reason": "琉球贡使到达日期待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003800",
      "reason": "玛瑙山战依校记订戊午；丙辰可能另指会师。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003801",
      "reason": "魏藻德同榜名录和河北各府免赋额度待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003802",
      "reason": "解学龙与黄道周审案详情待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003803",
      "reason": "秦良玉在夔州各次分战确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003805",
      "reason": "孙应元按校记；罗汝才、张献忠会合确日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003807",
      "reason": "剑州、绵州独立失守确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003810",
      "reason": "河南各城失守以及万安王遇害的具体纪日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p003811",
      "reason": "灾区分季范围、受灾人数待考。"
    }
  ]
}
