    ],
    "book": "资治通鉴",
    "volume": 282,
    "year": 940,
    "batch_key": "zztj-v282-y0940-p001-p010",
    "review": "安彦威入朝庚戌与后续楚地安置各有时间范围；言论归当事人。彭士愁任刺史为奏请。铜柱尺寸沿原单位，马援后裔是自称，不建确定远祖关系。"
  },
  {
    "id": "zztj-v282-y0940-p004",
    "source_line": 52,
    "text": "唐康化节度使兼中书令杨琏谒平陵还，一夕，大醉，卒于舟中，唐主追封谥曰弘农靖王。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_282_0940_yang_lian_dies",
