    },
    {
      "id": "mingshi-2f603db3d81e-p001830",
      "book_key": "mingshi",
      "book": "明史",
      "source_version": "2f603db3d81e",
      "section_id": "mingshi-2f603db3d81e-s0014",
      "section_title": "卷十三",
      "section_kind": "volume",
      "volume_candidate": 13,
      "volume_part": "",
      "volume_verified": false,
      "structural_volume_verified": true,
      "kind": "body",
      "text": "冬十二月癸卯，撫寧伯朱永為靖虜將軍，充總兵官，太監唐慎監軍，工部尚書白圭提督軍務，討荊、襄賊。是月，韓雍大破大藤峽瑤，改名峽曰「斷藤」。",
      "boundary_basis": "epub_source_paragraph",
      "review_status": "pending",
      "flags": [],
      "locator": {
        "source_file": "resources/originals/twenty-four-histories/24明史-EPUB全文.txt",
