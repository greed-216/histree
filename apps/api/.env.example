# Supabase Configuration
# You can get these values from `supabase status` if running locally
# Or from your Supabase Dashboard (Settings -> API) if using remote
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Histree source-backed questions (server only)
HISTREE_ASK_ENABLED=false
DEEPSEEK_API_KEY=
HISTREE_MODEL=deepseek-flash
# Set to 1 only behind the trusted nginx proxy
TRUST_PROXY=0


# Direct ECS AI ingress: server-only signing secret and quota RPC credential.
HISTREE_GATEWAY_SECRET=
# Supabase service-role key used only by the dedicated quota RPC client.
HISTREE_QUOTA_KEY=
HISTREE_ALLOW_ANONYMOUS=true
HISTREE_AI_ALLOWED_ORIGINS=https://123.56.189.146,https://histree.wiki,https://greed-216.github.io
