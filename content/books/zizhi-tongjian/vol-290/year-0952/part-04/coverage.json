  "coverage": "卷290原114—121行连续八段；本年跨卷290、291，后续仍待录入。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v290-y0952-p025",
      "note": "乙酉祭孔、墓拜修祠护林与访后裔授县官、丙戌离兖分开。既尊疑奠字旧本纪印证不改源；孔仁玉四十三代与颜涉后裔不当直系孙子，旧书留祭器细节补证。"
    },
    {
      "paragraph_id": "zztj-v290-y0952-p026",
      "note": "吴越顺德吴氏死日明确，但未明亲属，与钱弘俶母吴氏封谥关系待证，不仅同姓强合。"
    },
    {
      "paragraph_id": "zztj-v290-y0952-p027",
      "note": "千余家五千死、四室损及戊戌赦赈分开，未改成四庙或现代实测洪水。"
    },
    {
      "paragraph_id": "zztj-v290-y0952-p028",
      "note": "主己亥与旧戊戌返京纪日不同保留。"
    },
    {
      "paragraph_id": "zztj-v290-y0952-p029",
      "note": "父晖死与继业杀兄自掌、宋父病谋杀与父卒代职顺序分清；父晖对继业、继勋兄对继业明确，不造未明母亲。宋传字籍早牙职与两种父封爵按书记录。"
    },
    {
      "paragraph_id": "zztj-v290-y0952-p030",
      "note": "澣浣已核同人，海南按前后海真指代待校不作地名；海真妻弟对已故阮，信中童主对现璟。劝内附答允、绢表兄书、壬寅田到未行方案分开，旧海贞同日同官对应，旧夹宋注不当独立宋来源。"
    },
    {
      "paragraph_id": "zztj-v290-y0952-p031",
      "note": "六月辛亥朝廷授留后与此前自掌军府分开，起复不推服丧日数。"
    },
    {
      "paragraph_id": "zztj-v290-y0952-p032",
      "note": "故交称兄不造血缘，嫉妒不造三人派系。称疾求解、慰谕不来、节镇求保证呈信、拟临府、陈策、七月戊子入朝分录。福母李及郭兄福明确，宋太祖甥印证舅父；沧先世太原生地分清。"
    }
  ],
  "source_issues_review": "引文逐字保底本，纸本未核。既尊既奠、海南海真海贞字形、郭返京纪日、冯父封爵及杀兄谋杀时序按各书保留；吴太夫人身份封谥未强合。外交称兄与血亲分开，旧史夹宋引不作独立宋正文。",
  "plain_language_review": "首次逐条核对标题、人物、角色、关系、时间及事实说明；白话明确主语，祖裔不误作直系孙子，礼称不造血缘，允诺与执行、判断与已证事实分开。"
}
