      "source_sha256": "e3a21f0a5edb16fbc7da8bf4d588103e4ac7b1a5ad5b8202610eb03734096710",
      "verbatim_excerpt": "峦缢杀之。"
    },
    {
      "claim_id": "e46feedf-5def-5477-a797-0c0c4854cee6",
      "source_url": "https://github.com/greed-216/histree/blob/b987ace4/content/books/zizhi-tongjian/vol-275/year-0926/part-07/sources/library/tongjian-275-926-autumn-offices/source.txt",
