    "book": "资治通鉴",
    "volume": 286,
    "year": 947,
    "source_line": 60,
    "text": "戊子，帝遣使以诏书安集农民保聚山谷避契丹之患者。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_286_0947_liu_reassures_refugee_farmers"
    ],
