      "paragraph_id": "mingshi-2f603db3d81e-p000990",
      "reason": "多名藩王恢复旧封涉及各自爵位阶段，孟善稳定人物编号待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000991",
      "reason": "鬼力赤、哈立麻、高阳王身份、六府名录以及诸官署机构定位另考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000992",
      "reason": "吴高、陈瑄和宣信等人的规范人物键与大宁地理、海运供给范围待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000993",
      "reason": "安南承袭过程另跨数月，胡𡗨和李濬身份待核。夏原吉治水复用年表事件，补充四地和干支。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000994",
      "reason": "袁容、陈懋等封爵人选和各自爵号待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000995",
      "reason": "代王朱桂、郑亨规范人物键及改上尊谥的称号全文另考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000996",
      "reason": "第二次致书与第一次区分日期，书信内容和鬼力赤身份待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000997",
      "reason": "民户迁移的十郡九省范围和具体名单待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000998",
      "reason": "马彬身份、出使行程，及盛庸自杀日和缘由另查。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p000999",
      "reason": "韩观规范人物键、受颁历各国名单、治河分段另核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001000",
      "reason": "安南国王称号与规范人物键须进一步核对，闰十一月有公元跨年边界，以丁卯实核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001001",
      "reason": "各贡使到达的单独日期、书中所列国家或政权的规范称呼待核。"
    }
  ]
