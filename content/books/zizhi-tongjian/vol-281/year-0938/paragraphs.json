  },
  {
    "id": "zztj-v281-y0938-p033",
    "source_line": 99,
    "text": "河决郓州。",
    "status": "published_verified",
    "event_keys": [
      "event_zztj_281_0938_yunzhou_yellow_river_breach"
    ],
    "book": "资治通鉴",
