{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001835",
      "reason": "李贤父卒、请终制不获准，与年表所列回乡治丧和五月起复照原文分立。南漳战事与次月被擒分录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001836",
      "reason": "各路追击路径及石龙转进四川的确日待考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001837",
      "reason": "罗伦起草奏疏与朝廷实际贬任的日期根据其他传记再核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001838",
      "reason": "裴当稳定人物键和各军具体行动待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001840",
      "reason": "焦政稳定人物键与战斗详细地望待核。于冕复官依同时本纪记录。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001841",
      "reason": "石龙被擒在十月丁未。朱永进封日期存在正文、列传、世表三说，按校记取三年正月壬申。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001842",
      "reason": "成化二年十二月对应公元1467年，沿用年表已修记录。断藤峡再起纪文只记月份。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001843",
      "reason": "各贡使到达日期待核。选定底本在本段后直接接成化四年，维基文库同版亦然，卷内无成化三年独立年条。"
    }
  ]
}
