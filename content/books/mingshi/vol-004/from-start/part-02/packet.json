      "volume_candidate": 4,
      "volume_part": "",
      "volume_verified": false,
      "structural_volume_verified": true,
      "kind": "body",
      "text": "尋命安陸侯吳傑，江陰侯吳高，都督耿瓛，都指揮盛庸、潘忠、楊松、顧成、徐凱、李友、陳暉、平安，分道並進。置平燕布政使司於真定，尚書暴昭掌司事。",
      "boundary_basis": "epub_source_paragraph",
      "review_status": "pending",
      "flags": [],
      "locator": {
