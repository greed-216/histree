# Supabase Configuration
# You can get these values from `supabase status` if running locally
# Or from your Supabase Dashboard (Settings -> API) if using remote
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Histree source-backed questions (server only)
HISTREE_ASK_ENABLED=false
DEEPSEEK_API_KEY=
HISTREE_MODEL=deepseek-flash
# Set to 1 only behind the Render proxy
TRUST_PROXY=0

# Shared with ai-gateway only; at least 32 characters, never VITE_*
HISTREE_GATEWAY_SECRET=
