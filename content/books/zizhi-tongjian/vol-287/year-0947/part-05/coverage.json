  "coverage": "卷287原38—45行连续八段，本卷累计40/75；947年跨卷尚未完成。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v287-y0947-p033",
      "note": "李达孺赟沿李仁达主体，弟通另建限定身份；暂掌福州、赴钱唐、加官更名、贿赂求归、同意归程分录。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p034",
      "note": "拒调镇与先前收到任命区别，质子父子关系明确；幽州兵与契丹援兵数量分清，张琏未强合895年同名者；剥爵讨伐按闰七月庚午。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p035",
      "note": "正使为由暂代转正式，郭威仍副枢密使，旧史逐人职名补明；财政建议与扩兵后的用度评价不推金额。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p036",
      "note": "六庙及四亲庙政治奉祀不证明两汉血缘，不造无证祖系。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p037",
      "note": "侵夺、诬捕杀人、帝王车服声称、馆院职掌和严刑门禁分别整理，史家评价不冒充逐案调查，杀窥门者是命令。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p038",
      "note": "杀催粮使、攻邢州未克、洺州守战、侵吞差额、削汉兵粮、密谋与寺钟约信分录；李荣据宋史初名证识别新李筠，与晚唐同名和李昪父分档。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p039",
      "note": "辛巳召赴葬礼未成行、起兵夺库、白再荣受迫、北城退守与八月壬午反攻、鼓舞、北逃分录；两千余为阶段叙述，不与后段近三千相加；邪律忠即郎五沿既有主体。"
    },
    {
      "paragraph_id": "zztj-v287-y0947-p040",
      "note": "冯道辞推与白再荣地方暂掌、李彦从援军、王饶自卫和赵调停、围宅取财、杀人及征财计划被阻、拘旧属取财分录；未将被阻杀人写成已死，旧传受害范围和译名问题保留。"
    }
  ],
  "source_issues_review": "张琏身份待考；李筠原名李荣据宋史确证，限定别名避免早期同名；麻答满达勒床答勒与旧传杀逐异叙待核，死亡人数引用不累加；礼庙不推血统，命令与执行分清。",
  "plain_language_review": "首次逐项核对人物、事件、参与角色、关系方向、时间地点、出处及事实说明，明确计划、被阻行动、约数、史家评价和实际结果；所有逐字摘录保留底本字形。"
}
