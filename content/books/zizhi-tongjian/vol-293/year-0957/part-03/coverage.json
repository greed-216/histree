  "excluded_non_body": [],
  "coverage": "原79—86行连续八段，后续未计。",
  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v293-y0957-p015",
      "note": "庚戌迁治赦令与复业禁仇、旧五十里租税和赎亲葬骸拆分，不当全部政策即日落实。辛亥授任卒，列传受降是日卒合叙异说保留；郡主与两史郡王字形校核，不按异常字造女子。崇赞与崇让缺同人证据分别保存，后授官年不明。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p016",
      "note": "韩伦干政受讼、子哭求与癸丑免死配流分开；后赦还与洛阳十阿父概述year null，不造十人名单。柴守礼为生父但元舅礼遇不是血缘舅甥，郭威太祖身份明确；杀人不补死者姓名。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p017",
      "note": "开仓下诏与旧明尹日就执行人关联同事件；丙辰北还、四月己巳抵京分阶段。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p018",
      "note": "修殿督工、丁丑孙处刑与厨官三停职分别录；削柿名物待校，不译水果，不造贪污金额。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p019",
      "note": "怀恩军编于955秦凤战后，是追述，与怀德军区分；乙亥八百余西还不写全军已抵蜀。壬午见辞与旧丙子三请可能不同次数，日保异说，旧引宋李蒨题名疑，不造另一人或现代病诊断。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p020",
      "note": "甲申六军三十指挥怀德军为组织单位非精确人数。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p021",
      "note": "乙酉疏水命令与后来通航概述分开，未给工程竣工日，不加现代坐标。"
    },
    {
      "paragraph_id": "zztj-v293-y0957-p022",
      "note": "五月丁酉赵匡胤领义成，旧滑州同称，检校太保及仍殿前职独立补明。"
    }
  ],
  "source_issues_review": "郡主与郡王字形、削柿名物、旧注文李蒨题名保原待校；死亡列传合叙和李谷请退纪日分别保留。旧本传将陈承昭被俘合入紫金山，未用该叙述给本批定日。崇赞崇让无同人桥证，未知年份不强定。纸本及异文待核。",
  "plain_language_review": "首次逐条检查人物、标题正文、参与角色、关系方向及事实解释；诏令与落实、署名和追赠、辞职与批准、政治舅称与血缘区分。回述任内行为不硬定957，保留各书原文及异说，匿名亲属和死者不补造姓名。"
}
