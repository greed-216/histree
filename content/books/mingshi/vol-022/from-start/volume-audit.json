  "pending_paragraphs": [
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003513",
      "observations": [
        "朱由校出生只得原历月，告天下之确日待查。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003515",
      "observations": [
        "周嘉谟、左光斗及王安舜各自上疏确日和册封客氏确日待核。红丸是否致死留作异说，不从上疏推定。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003516",
      "observations": [
        "葬两人合用同一事件。袁应泰公元年与孙如游十月日序已核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003517",
      "observations": [
        "郭氏为嫡母，王氏为生母，和李选侍分开。长谥据后妃传待续录。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003520",
      "observations": [
        "获谥七十三人的完整名单未见于本段。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003522",
      "observations": [
        "免除戍籍的齐、黄两家亲属名单未载。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003523",
      "observations": [
        "浑河之战和张铨被俘、去世的确日及分批经过待另证。白话将当时政权称后金。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003525",
      "observations": [
        "红苗一事的具体参与方与宁夏军溃散确日待核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003528",
      "observations": [
        "镇江城为辽东战事地名，不能按今江苏镇江设坐标。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003530",
      "observations": [
        "朱燮元升巡抚、秦良玉出兵的独立确日待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003532",
      "observations": [
        "各地贡使到达确日待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003534",
      "observations": [
        "罗一贵疑作罗一贯，暂保留异文。平阳桥战和成都解围各自确日待考。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003535",
      "observations": [
        "从起兵到围贵阳涉及多地，分地陷落时间待考。孙承宗任命确日与兼理部务日分别核。"
      ]
    },
    {
      "batch": "part-01",
      "paragraph_id": "mingshi-2f603db3d81e-p003536",
      "observations": [
        "同榜名单和内操开始确日待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003538",
      "observations": [
        "方孝孺获谥的确日、后人姓名及张彦芳进官确日待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003539",
      "observations": [
        "大坝与遵义失守分别发生的确日、于弘志被处死的确日待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003541",
      "observations": [
        "朱由检以明光宗之子沿用原稳定键，后来的即位在下一卷另录。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003545",
      "observations": [
        "贡使抵达确日待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003547",
      "observations": [
        "“红夷据澎湖”按本纪纪日登记，荷兰船队到达日期及中外记载差异待校；四人获授职衔和到任分开。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003548",
      "observations": [
        "孟承光的母、子遇难详情及各自获赠名目待核。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003549",
      "observations": [
        "朝鲜方面的政变日期记载待对照，留存本纪纪日。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003554",
      "observations": [
        "因皇子出生而大赦可核，生子确日与身份待结合诸王传。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003557",
      "observations": [
        "贡使到达日期待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003559",
      "observations": [
        "吴野樵获刑和官兵遇伏的分别确日，死难官将全名单待考。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003560",
      "observations": [
        "明熹宗患病确日未载。"
      ]
    },
    {
      "batch": "part-02",
      "paragraph_id": "mingshi-2f603db3d81e-p003561",
      "observations": [
        "京师各次地震确日待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p003563",
      "observations": [
        "万燝、林汝翥遇责及各地奏疏各自确日待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p003565",
      "observations": [
        "三人削籍确日未载。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p003566",
      "observations": [
        "普定与织金两战各自日期待核。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p003567",
      "observations": [
        "两当民变的确日和经过待考。"
      ]
    },
    {
      "batch": "part-03",
      "paragraph_id": "mingshi-2f603db3d81e-p003569",
      "observations": [
