  "reviewed_questions": [
    {
      "paragraph_id": "zztj-v270-y0918-p023",
      "note": "张万进附晋与刘鄩奉梁命讨伐分录；旧五代史卷28也记己酉归款。"
    },
    {
      "paragraph_id": "zztj-v270-y0918-p024",
      "note": "主书仅称蜀顺德皇后，个人名及与其他周氏的同一性未有本段证据，暂以称号建主体。"
    },
    {
      "paragraph_id": "zztj-v270-y0918-p025",
      "note": "宋光葆为宋光嗣从弟有原文明证，按前者指向后者建立“从弟”关系。"
    },
    {
      "paragraph_id": "zztj-v270-y0918-p026",
      "note": "晋王多次轻骑挑战为背景，谢彦章伏兵和李存审救援为本段具体经过；旧五代史卷28有同事补证。"
    },
    {
      "paragraph_id": "zztj-v270-y0918-p027",
      "note": "吴将张宣夜袭破楚军后，吴越与闽军闻败引归；不记为同时被吴军正面击败。"
    },
    {
      "paragraph_id": "zztj-v270-y0918-p028",
      "note": "梅山蛮是史书集体称谓，不据此建单一人物。"
    }
  ]
}
