{
  "status": "open",
  "items": [
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001016",
      "reason": "责谕安南的使者身份和辞旨待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001017",
      "reason": "雒佥处分据本纪原由，另查其奏议文本。赵王朱高燧规范人物键待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001019",
      "reason": "郑和航次具体港口和路线、山寿的稳定人物键与陈天平身世待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001020",
      "reason": "三百三十八万石为本纪所载，受灾区域和实际迁居的一万户各有口径。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001021",
      "reason": "梅殷遭杀经过待与相关本传核对；齐王三次书诫的各自具体日待核。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001022",
      "reason": "八百地名及沐晟的规范人物编号待核。安南护送者身份、出发与抵达分别校考。"
    },
    {
      "paragraph_id": "mingshi-2f603db3d81e-p001023",
      "reason": "各国规范名称、来使和封爵的具体月份待核。"
    }
  ]
}
